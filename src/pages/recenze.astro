---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const reviewSources = [
  {
    name: 'Booking.com',
    rating: '9,4 / 10',
    count: '98 hodnocení',
    note: 'Ověřené pobyty přes rezervační platformu Booking.com.',
    url: 'https://www.booking.com/hotel/cz/apartmany-cerny-vlk-borova-lada.cs.html',
    cta: 'Zobrazit Booking.com',
  },
  {
    name: 'Google',
    rating: '4,9 / 5',
    count: '93 hodnocení',
    note: 'Veřejné hodnocení hostů na firemním profilu v Mapách Google.',
    url: 'https://maps.google.com/?cid=932837692893333767',
    cta: 'Zobrazit Google',
  },
  {
    name: 'Mapy.com',
    rating: '5,0 / 5',
    count: '24 hodnocení',
    note: 'Lokální hodnocení a zkušenosti návštěvníků na Mapy.com.',
    url: 'https://mapy.com/cs/?source=firm&id=13391926',
    cta: 'Zobrazit Mapy.com',
  },
  {
    name: 'Previo.cz',
    rating: '9,7 / 10',
    count: '84 hodnocení',
    note: 'Hodnocení hostů přímo v rezervačním systému Previo.',
    url: 'https://booking.previo.app/review/?hotId=756911&currency=CZK&lang=cs&redirectType=iframe&PHPSESSID=ul3mcupk25mapov978ofg1ef6b',
    cta: 'Zobrazit Previo.cz',
  },
];

const reviewThemes = [
  {
    title: 'Čistota a vybavení',
    text: 'Hosté často zmiňují vysokou úroveň čistoty, kvalitní vybavení apartmánů a dobře promyšlené zázemí pro pohodlný pobyt.',
  },
  {
    title: 'Klidná lokalita',
    text: 'V recenzích se opakovaně objevuje klid Borových Lad a výborná poloha pro výlety, běžky, kola i pohodové dny na Šumavě.',
  },
  {
    title: 'Pohodlný příjezd',
    text: 'Velmi pozitivně bývá hodnocen jednoduchý příjezd, parkování u objektu a bezproblémový vstup pomocí kódových zámků.',
  },
  {
    title: 'Rodiny i aktivní hosté',
    text: 'Recenze potvrzují, že zázemí dobře funguje jak pro rodiny s dětmi, tak pro hosty, kteří přijíždějí za turistikou nebo sportem.',
  },
];

const featuredReview = {
  quote:
    'Krásné, čisté a výborně vybavené apartmány na skvělém místě. Oceňujeme klid, pohodlné parkování i perfektní výchozí bod pro výlety po Šumavě.',
  source: 'Booking.com',
  meta: 'Ověřené hodnocení hosta',
};

const reviews = [
  {
    quote: 'Dispozičně skvěle řešeno, vybavenost na výborné úrovni – de facto nám tu nechybělo nic, od vybavení kuchyně po vysoušeč bot.',
    source: 'Booking.com',
    meta: 'Jindřiška · duben 2025',
  },
  {
    quote: 'Beautiful location, stylish apartments, directly connected to the surrounding green areas. Well equipped kitchen, practical storage room.',
    source: 'Booking.com',
    meta: 'Hunor · Německo',
  },
  {
    quote: 'Apartmány jsou nové, hezky útulně zařízené. Dovolenou jsme si užili a rádi se vrátíme znovu.',
    source: 'Google',
    meta: 'Tomáš',
  },
  {
    quote: 'Hosté opakovaně oceňují klidné prostředí, čistotu a velmi dobré zázemí pro delší i kratší pobyt.',
    source: 'Souhrn recenzí',
    meta: 'Napříč platformami',
  },
  {
    quote: 'Silnou stránkou ubytování je také lokalita v Borových Ladech a pohodlný výchozí bod pro výlety po Šumavě.',
    source: 'Souhrn recenzí',
    meta: 'Napříč platformami',
  },
  {
    quote: 'Velmi dobře je hodnocena i praktičnost pobytu — parkování, dostupnost a bezproblémový příjezd.',
    source: 'Souhrn recenzí',
    meta: 'Napříč platformami',
  },
];

const externalLinks = [
  {
    name: 'Booking.com',
    text: 'Kompletní hodnocení a recenze z ověřených pobytů na Booking.com.',
    url: 'https://www.booking.com/hotel/cz/apartmany-cerny-vlk-borova-lada.cs.html',
  },
  {
    name: 'Google',
    text: 'Firemní profil s veřejnými recenzemi a hodnocením v Mapách Google.',
    url: 'https://maps.google.com/?cid=932837692893333767',
  },
  {
    name: 'Mapy.com',
    text: 'Profil ubytování s hodnocením a zkušenostmi návštěvníků na Mapy.com.',
    url: 'https://mapy.com/cs/?source=firm&id=13391926',
  },
  {
    name: 'Previo.cz',
    text: 'Profil s recenzemi a hodnocením v rezervačním systému Previo.',
    url: 'https://booking.previo.app/review/?hotId=756911&currency=CZK&lang=cs&redirectType=iframe&PHPSESSID=ul3mcupk25mapov978ofg1ef6b',
  },
];
---

<BaseLayout
  lang="cs"
  title="Recenze hostů | Apartmány Černý vlk"
  description="Podívejte se, jak hodnotí pobyt hosté Apartmánů Černý vlk na Booking.com, Google, Mapy.com a Previo.cz. Přehled hodnocení, hlavní důvody spokojenosti i přesné odkazy na jednotlivé profily."
>
  <Header />

  <section class="reviews-hero" id="uvod">
    <div
      class="reviews-hero__bg"
      style="background-image:url('/images/hero/hero-borova-lada.jpg');"
    ></div>
    <div class="reviews-hero__overlay"></div>

    <div class="reviews-hero__content">
      <p class="reviews-hero__eyebrow">Recenze hostů</p>

      <h1>
        Zkušenosti hostů
        <em>na jednom místě</em>
      </h1>

      <p class="reviews-hero__lead">
        Přehled hodnocení z více nezávislých platforem nabízí jasný a věcný pohled na to,
        jak hosté vnímají čistotu, vybavení, lokalitu i celkový komfort pobytu v Apartmánech Černý vlk.
      </p>

      <div class="reviews-hero__actions">
        <a href="#zdroje" class="reviews-btn reviews-btn--primary">Zobrazit hodnocení</a>
        <a href="#odkazy" class="reviews-btn reviews-btn--ghost">Přesné odkazy</a>
      </div>
    </div>

    <div class="reviews-hero__scroll" aria-hidden="true">Scroll</div>
  </section>

  <section class="reviews-sources" id="zdroje">
    <div class="section-inner">
      <div class="reviews-section-head">
        <div>
          <p class="section-label">Přehled zdrojů</p>
          <h2 class="section-title">Hodnocení napříč <em>nezávislými platformami</em></h2>
        </div>
        <p class="section-note">
          Každý zdroj uvádíme samostatně, aby bylo zřejmé, odkud hodnocení pochází a kde si je můžete ověřit.
        </p>
      </div>

      <div class="sources-grid">
        {reviewSources.map((item) => (
          <article class="source-card">
            <div class="source-card__top">
              <p class="source-card__name">{item.name}</p>
              <div class="source-card__rating">{item.rating}</div>
            </div>

            <p class="source-card__count">{item.count}</p>
            <p class="source-card__note">{item.note}</p>

            <a href={item.url} class="source-card__link" target="_blank" rel="noopener noreferrer">
              {item.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-themes">
    <div class="section-inner">
      <div class="reviews-section-head reviews-section-head--narrow">
        <div>
          <p class="section-label">Co hosté oceňují</p>
          <h2 class="section-title">Nejčastěji zmiňované důvody <em>spokojenosti</em></h2>
        </div>
      </div>

      <div class="themes-grid">
        {reviewThemes.map((item) => (
          <article class="theme-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-testimonials">
    <div class="section-inner">
      <div class="reviews-section-head">
        <div>
          <p class="section-label">Vybrané recenze</p>
          <h2 class="section-title">Krátce a konkrétně: co hosté píší <em>po pobytu</em></h2>
        </div>
        <p class="section-note">
          Krátké ukázky níže shrnují témata, která se v hodnoceních opakují nejčastěji.
        </p>
      </div>

      <div class="testimonials-grid">
        <article class="testimonial-card testimonial-card--featured">
          <div class="testimonial-card__quote-mark">“</div>
          <blockquote>{featuredReview.quote}</blockquote>
          <div class="testimonial-card__meta">
            <span>{featuredReview.source}</span>
            <span>{featuredReview.meta}</span>
          </div>
        </article>

        {reviews.map((item) => (
          <article class="testimonial-card">
            <blockquote>{item.quote}</blockquote>
            <div class="testimonial-card__meta">
              <span>{item.source}</span>
              <span>{item.meta}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-links" id="odkazy">
    <div class="section-inner">
      <div class="reviews-section-head">
        <div>
          <p class="section-label">Přesné odkazy</p>
          <h2 class="section-title">Recenze si můžete projít přímo <em>u zdroje</em></h2>
        </div>
        <p class="section-note">
          Každý odkaz vede na veřejný profil nebo stránku s hodnocením.
        </p>
      </div>

      <div class="links-list">
        {externalLinks.map((item) => (
          <article class="link-card">
            <div class="link-card__body">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </div>

            <a
              href={item.url}
              class="reviews-btn reviews-btn--secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Otevřít {item.name}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-cta">
    <div class="section-inner reviews-cta__inner">
      <div>
        <p class="section-label">Rezervace</p>
        <h2 class="section-title">Ve zkušenostech hostů máte jasno. Teď už jen vybrat <em>apartmán</em></h2>
      </div>

      <div class="reviews-cta__actions">
        <a href="/#apartmany" class="reviews-btn reviews-btn--primary">Zobrazit apartmány</a>
        <a href="/#rezervace" class="reviews-btn reviews-btn--secondary">Přejít na rezervaci</a>
      </div>
    </div>
  </section>

  <Footer lang="cs" />

  <style>
    .reviews-hero {
      position: relative;
      min-height: 82svh;
      display: grid;
      align-items: end;
      overflow: clip;
      background: var(--color-bg);
    }

    .reviews-hero__bg {
      position: absolute;
      inset: 0;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      transform: scale(1.02);
    }

    .reviews-hero__overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(12, 14, 12, 0.74) 0%, rgba(12, 14, 12, 0.32) 42%, rgba(12, 14, 12, 0.12) 100%);
    }

    .reviews-hero__content {
      position: relative;
      z-index: 2;
      width: min(100%, 880px);
      padding: clamp(6rem, 10vw, 9rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
      margin-inline: auto;
      color: #f8f3eb;
    }

    .reviews-hero__eyebrow,
    .section-label {
      margin: 0 0 0.85rem;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .reviews-hero__eyebrow {
      color: rgba(248, 243, 235, 0.78);
    }

    .section-label {
      color: var(--color-muted);
    }

    .reviews-hero h1 {
      margin: 0;
      font-size: clamp(2.8rem, 7vw, 5.8rem);
      line-height: 0.94;
      letter-spacing: -0.03em;
      color: #f8f3eb;
    }

    .reviews-hero h1 em,
    .section-title em {
      display: inline-block;
      font-style: italic;
      font-weight: 500;
      opacity: 0.92;
      padding-right: 0.06em;
      padding-bottom: 0.06em;
    }

    .reviews-hero__lead {
      max-width: 44rem;
      margin: 1.5rem 0 0;
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.75;
      color: rgba(248, 243, 235, 0.88);
    }

    .reviews-hero__actions,
    .reviews-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .reviews-hero__scroll {
      position: absolute;
      right: 1.25rem;
      bottom: 1.25rem;
      z-index: 2;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(248, 243, 235, 0.65);
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .reviews-btn,
    .reviews-btn:link,
    .reviews-btn:visited {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      padding: 0.9rem 1.35rem;
      border-radius: 999px;
      border: 1px solid transparent;
      text-decoration: none;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .reviews-btn--primary,
    .reviews-btn--primary:link,
    .reviews-btn--primary:visited {
      background-color: #6f8f6b;
      border-color: #6f8f6b;
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(30, 40, 30, 0.18);
    }

    .reviews-btn--primary:hover,
    .reviews-btn--primary:focus-visible {
      background-color: #5f7d5b;
      border-color: #5f7d5b;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(30, 40, 30, 0.22);
    }

    .reviews-btn--ghost,
    .reviews-btn--ghost:link,
    .reviews-btn--ghost:visited {
      background-color: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.32);
      color: #ffffff;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .reviews-btn--ghost:hover,
    .reviews-btn--ghost:focus-visible {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.46);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .reviews-btn--secondary,
    .reviews-btn--secondary:link,
    .reviews-btn--secondary:visited {
      border-color: var(--color-border);
      background: transparent;
      color: var(--color-text);
    }

    .reviews-btn--secondary:hover,
    .reviews-btn--secondary:focus-visible {
      background: var(--color-card);
      transform: translateY(-1px);
    }

    .section-inner {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .reviews-sources,
    .reviews-themes,
    .reviews-testimonials,
    .reviews-links,
    .reviews-cta {
      padding: clamp(4.5rem, 7vw, 7rem) 0;
    }

    .reviews-sources,
    .reviews-testimonials {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .reviews-section-head {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: end;
      margin-bottom: 2rem;
    }

    .reviews-section-head--narrow {
      align-items: start;
    }

    .section-title {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .section-note {
      max-width: 30rem;
      margin: 0;
      font-size: 1.02rem;
      line-height: 1.8;
      color: var(--color-muted);
    }

    .sources-grid,
    .themes-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .source-card,
    .theme-card,
    .testimonial-card,
    .link-card {
      border: 1px solid var(--color-border);
      border-radius: 1.4rem;
      background: var(--color-card);
    }

    .source-card {
      padding: 1.5rem;
      display: grid;
      gap: 0.9rem;
    }

    .source-card__top {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: start;
    }

    .source-card__name {
      margin: 0;
      font-size: 1rem;
      line-height: 1.4;
      color: var(--color-heading);
      font-weight: 700;
    }

    .source-card__rating {
      font-size: 1.35rem;
      line-height: 1.15;
      font-weight: 700;
      color: var(--color-heading);
      text-align: right;
      white-space: nowrap;
    }

    .source-card__count,
    .source-card__note {
      margin: 0;
      line-height: 1.7;
    }

    .source-card__count {
      color: var(--color-text);
      font-weight: 600;
    }

    .source-card__note {
      color: var(--color-muted);
      font-size: 0.98rem;
    }

    .source-card__link {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      margin-top: 0.2rem;
      color: var(--color-heading);
      text-decoration: none;
      font-weight: 600;
      border-bottom: 1px solid transparent;
      transition: border-color 180ms ease, color 180ms ease;
    }

    .source-card__link:hover,
    .source-card__link:focus-visible {
      border-color: currentColor;
    }

    .theme-card {
      padding: 1.5rem;
    }

    .theme-card h3,
    .link-card h3 {
      margin: 0 0 0.9rem;
      font-size: 1.35rem;
      line-height: 1.15;
      color: var(--color-heading);
    }

    .theme-card p,
    .link-card p {
      margin: 0;
      color: var(--color-text);
      line-height: 1.8;
      font-size: 1.02rem;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .testimonial-card {
      padding: 1.5rem;
      display: grid;
      gap: 1rem;
    }

    .testimonial-card--featured {
      grid-column: span 2;
      padding: 1.75rem;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.72) 0%, rgba(255,255,255,0.96) 100%),
        var(--color-card);
    }

    .testimonial-card__quote-mark {
      font-size: 3.4rem;
      line-height: 0.8;
      color: var(--color-muted);
    }

    .testimonial-card blockquote {
      margin: 0;
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--color-text);
    }

    .testimonial-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
      align-items: center;
      color: var(--color-muted);
      font-size: 0.95rem;
    }

    .testimonial-card__meta span:first-child {
      color: var(--color-heading);
      font-weight: 600;
    }

    .links-list {
      display: grid;
      gap: 1rem;
    }

    .link-card {
      display: flex;
      justify-content: space-between;
      gap: 1.5rem;
      align-items: center;
      padding: 1.5rem;
    }

    .link-card__body {
      max-width: 52rem;
    }

    .reviews-cta__inner {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: end;
    }

    @media (max-width: 1080px) {
      .sources-grid,
      .themes-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .testimonials-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .link-card,
      .reviews-cta__inner {
        display: grid;
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .reviews-hero {
        min-height: 76svh;
      }

      .reviews-hero__content {
        padding-inline: 1rem;
      }

      .reviews-section-head,
      .reviews-cta__inner {
        display: grid;
        gap: 1rem;
        align-items: start;
      }

      .sources-grid,
      .themes-grid,
      .testimonials-grid {
        grid-template-columns: 1fr;
      }

      .testimonial-card--featured {
        grid-column: auto;
      }

      .reviews-hero__actions,
      .reviews-cta__actions {
        flex-direction: column;
        align-items: stretch;
      }

      .reviews-btn {
        width: 100%;
      }

      .reviews-hero__scroll {
        display: none;
      }
    }
  </style>
</BaseLayout>
