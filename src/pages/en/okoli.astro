---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="en"
  title="Surroundings and activities | Apartmány Černý vlk"
  description="Borová Lada and central Šumava offer peaceful nature, cross-country trails, trips with children, cycling routes and full-day mountain hikes. Discover activity tips around Apartmány Černý vlk."
  image="/images/okoli/okoli-01.jpg"
>
  <Header />

  <section class="hero" id="uvod">
    <div
      class="hero-bg"
      style="background-image:url('/images/okoli/okoli-01.jpg');"
      aria-hidden="true"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Surroundings · Šumava</p>
      <h1>
        Šumava right outside your door.
        <em>In every season.</em>
      </h1>
      <p class="hero-perex">
        Borová Lada is an excellent starting point for peaceful walks, family trips,
        cross-country skiing, cycling and full-day mountain hikes. In the surrounding area you will find nature,
        sports facilities and many of the best-known places in central Šumava.
      </p>
      <div class="hero-actions">
        <a href="#rocni-obdobi" class="btn-primary">What to do throughout the year</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">Scroll</div>
  </section>

  <section class="surroundings-intro">
    <div class="section-inner surroundings-intro__grid">
      <div>
        <p class="section-label">Borová Lada</p>
        <h2 class="section-title">A place where <em>peace, nature and movement</em> come together</h2>
      </div>

      <div class="surroundings-copy">
        <p>
          Borová Lada is one of the most beautiful places in central Šumava. The area offers unspoilt nature,
          the pleasant pace of a small mountain village and good facilities for a stay in any season.
        </p>
        <p>
          Just a short walk from the accommodation you will find table tennis, a children’s playground and a multifunctional sports court for tennis,
          volleyball, foot tennis, futsal and handball. The village also has two restaurants, the café
          <a href="https://www.facebook.com/people/Caf%C3%A9-Snack-Madam-%C4%8Cokol%C3%A1da-Borov%C3%A1-Lada/100063483432963/" target="_blank" rel="noopener noreferrer">Madam čokoláda</a>,
          a small shop, a post office and sports equipment rental options.
        </p>
      </div>
    </div>
  </section>

  <section class="surroundings-highlights">
    <div class="section-inner">
      <p class="section-label">Why here</p>
      <h2 class="section-title">What makes the surroundings of Černý vlk <em>special</em></h2>

      <div class="highlights-grid">
        <article class="highlight-card highlight-card--wide">
          <h3>Central Šumava within easy reach</h3>
          <p>
            From Borová Lada, you can easily reach the best-known Šumava destinations as well as quieter routes
            appreciated by guests looking for peace and open space.
          </p>
          <p>
            It is an excellent starting point for trips towards Kvilda, Modrava, Srní and other parts of Šumava National Park.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Winter without compromise</h3>
          <p>
            Cross-country ski trails, sledging, ice skating and easy access to smaller ski resorts.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Spring to autumn</h3>
          <p>
            Short walks, trips with children, cycling routes and full-day hikes across ridges and to popular Šumava destinations.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Also great for families</h3>
          <p>
            The area offers easy routes, educational sites and stops that children and adults both enjoy.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Practical local facilities</h3>
          <p>
            Essential services and sports facilities are close at hand, while the atmosphere of a Šumava village remains untouched.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="season-section" id="rocni-obdobi">
    <div class="section-inner">
      <p class="section-label">Throughout the year</p>
      <h2 class="section-title">Every season in Šumava has <em>its own charm</em></h2>

      <div class="season-stack">
        <article class="season-feature">
          <div class="season-feature__media">
            <img
              src="/images/okoli/okoli-10.jpg"
              alt="Springtime Šumava landscape near Borová Lada"
              loading="lazy"
              width="1600"
              height="1067"
            />
          </div>
          <div class="season-feature__content">
            <div class="season-card__header">
              <h3>Spring</h3>
            </div>
            <p>
              Spring is ideal for shorter trips, the first longer walks and watching the Šumava landscape come back to life.
              Lighter routes around Borová Lada are perfect at this time, as well as stops at popular natural sites –
              the <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/informacni-stredisko-svinna-lada/" target="_blank" rel="noopener noreferrer">Chalupská peat bog</a>,
              the <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/sovi-voliery/" target="_blank" rel="noopener noreferrer">owl aviaries</a>,
              or the area along the <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/rybi-lihen/" target="_blank" rel="noopener noreferrer">trout hatcheries</a>
              by the Vltava stream.
            </p>
            <p>
              This is exactly the time when the calm of the surrounding landscape and the lower visitor numbers compared with peak season stand out the most.
            </p>
          </div>
        </article>

        <article class="season-feature season-feature--reverse">
          <div class="season-feature__media">
            <img
              src="/images/okoli/okoli-08.jpg"
              alt="Summer trips and landscape of central Šumava"
              loading="lazy"
              width="1600"
              height="1067"
            />
          </div>
          <div class="season-feature__content">
            <div class="season-card__header">
              <h3>Summer</h3>
            </div>
            <p>
              Summer is ideal for hiking, cycling trips and full-day programmes across central Šumava.
            </p>
            <p>
              Within easy reach are light family routes as well as more demanding mountain destinations – whether the Šumava National Park visitor centres,
              <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/navstevnicke-centrum-kvilda/" target="_blank" rel="noopener noreferrer">deer and lynx in Kvilda</a>,
              <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/nc-srni/" target="_blank" rel="noopener noreferrer">wolves in Srní</a>,
              or trips to <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/informacni-stredisko-polednik/" target="_blank" rel="noopener noreferrer">Poledník</a>,
              <a href="https://www.npsumava.cz/navstivte-sumavu/navstevnicka-centra/informacni-stredisko-idina-pila/" target="_blank" rel="noopener noreferrer">Boubín</a> and other places.
            </p>
            <p>
              On hot days, the higher altitude is a real advantage, with a more pleasant climate than in lower areas.
            </p>
          </div>
        </article>

        <article class="season-feature">
          <div class="season-feature__media">
            <img
              src="/images/okoli/okoli-03.jpg"
              alt="Autumn landscape in Šumava with colourful forests"
              loading="lazy"
              width="1600"
              height="1067"
            />
          </div>
          <div class="season-feature__content">
            <div class="season-card__header">
              <h3>Autumn</h3>
            </div>
            <p>
              Autumn in Šumava offers the calmest atmosphere, clear views and beautiful colours of forests and meadows.
              It is the ideal time for walking trips, photography and slower exploration of the area.
            </p>
            <p>
              If you are looking for a quieter stay outside the summer peak, autumn is often one of the very best times to come.
            </p>
          </div>
        </article>

        <article class="season-feature season-feature--reverse">
          <div class="season-feature__media">
            <img
              src="/images/okoli/okoli-02.jpg"
              alt="Winter in Šumava near Borová Lada"
              loading="lazy"
              width="1600"
              height="1067"
            />
          </div>
          <div class="season-feature__content">
            <div class="season-card__header">
              <h3>Winter</h3>
            </div>
            <p>
              In winter, Borová Lada is an excellent choice especially for cross-country skiers. The surrounding area offers groomed trails,
              and it is also easy to reach other popular
              <a href="https://bilastopa.cz/cs/uvodni-strana-2/" target="_blank" rel="noopener noreferrer">cross-country sections of central Šumava</a>.
            </p>
            <p>
              There is a sledging slope and ice skating in the village for both children and adults.
              When conditions allow, you will also find smaller ski resorts within 15–30 minutes by car,
              generally better suited to beginners –
              <a href="http://www.skikvilda.cz" target="_blank" rel="noopener noreferrer">Kvilda</a>,
              <a href="https://www.lazadov.cz/la/" target="_blank" rel="noopener noreferrer">Zadov</a>,
              <a href="https://www.novehute.cz/novehute/" target="_blank" rel="noopener noreferrer">Nové Hutě</a>,
              <a href="https://www.ski-kubovka.com" target="_blank" rel="noopener noreferrer">Kubova Huť</a>
              and <a href="https://www.skivltavice.cz" target="_blank" rel="noopener noreferrer">Horní Vltavice</a>,
              or you can head to the German ski centre
              <a href="https://www.mitterdorf.info/cs/" target="_blank" rel="noopener noreferrer">Mitterdorf</a>,
              about half an hour away.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="surroundings-cta">
    <div class="section-inner surroundings-cta__inner">
      <div>
        <p class="section-label">Stay in Šumava</p>
        <h2 class="section-title">You already have the plan. Now choose your <em>apartment</em></h2>
      </div>
      <div class="surroundings-cta__actions">
        <a href="/en" class="btn-primary">View apartments</a>
      </div>
    </div>
  </section>

  <Footer lang="en" />

  <style>
    .surroundings-intro,
    .surroundings-highlights,
    .season-section,
    .surroundings-cta {
      padding: clamp(4.5rem, 7vw, 7rem) 0;
    }

    .surroundings-intro__grid {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .surroundings-copy p,
    .highlight-card p,
    .season-feature__content p {
      margin: 0 0 1rem;
      font-size: 1.04rem;
      line-height: 1.85;
      color: var(--color-text);
    }

    .surroundings-copy a,
    .season-feature__content a {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    .surroundings-highlights {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .highlights-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .highlight-card {
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 1.4rem;
      background: var(--color-card);
    }

    .highlight-card--wide {
      grid-column: span 2;
    }

    .highlight-card h3,
    .season-feature h3 {
      margin: 0 0 0.85rem;
      font-size: 1.35rem;
      line-height: 1.15;
      color: var(--color-heading);
    }

    .season-stack {
      display: grid;
      gap: 1.25rem;
      margin-top: 2.5rem;
    }

    .season-feature {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(1.25rem, 3vw, 2rem);
      align-items: stretch;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 1.6rem;
      background: var(--color-card);
      overflow: hidden;
    }

    .season-feature--reverse .season-feature__media {
      order: 2;
    }

    .season-feature--reverse .season-feature__content {
      order: 1;
    }

    .season-feature__media {
      min-height: 100%;
    }

    .season-feature__media img {
      width: 100%;
      height: 100%;
      min-height: 320px;
      object-fit: cover;
      border-radius: 1.15rem;
      display: block;
    }

    .season-feature__content {
      padding: clamp(0.5rem, 1vw, 1rem) clamp(0.25rem, 0.8vw, 0.5rem);
      align-self: center;
    }

    .season-card__header {
      margin-bottom: 0.75rem;
    }

    .surroundings-cta__inner {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: end;
    }

    .surroundings-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      justify-content: flex-end;
    }

    @media (max-width: 1080px) {
      .surroundings-intro__grid,
      .surroundings-cta__inner,
      .season-feature {
        grid-template-columns: 1fr;
        display: grid;
      }

      .highlights-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .highlight-card--wide {
        grid-column: span 2;
      }

      .season-feature--reverse .season-feature__media,
      .season-feature--reverse .season-feature__content {
        order: initial;
      }
    }

    @media (max-width: 720px) {
      .highlights-grid {
        grid-template-columns: 1fr;
      }

      .highlight-card--wide {
        grid-column: auto;
      }

      .season-feature {
        padding: 0.85rem;
        border-radius: 1.25rem;
      }

      .season-feature__media img {
        min-height: 240px;
        border-radius: 1rem;
      }

      .surroundings-cta__inner {
        display: grid;
        gap: 1rem;
        align-items: start;
      }

      .surroundings-cta__actions {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
