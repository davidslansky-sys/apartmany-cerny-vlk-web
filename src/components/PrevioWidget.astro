---
interface Props {
  lang?: 'cs' | 'de' | 'en';
}

const { lang = 'cs' } = Astro.props;

const langMap = {
  cs: 'cs',
  de: 'de',
  en: 'en',
};

const previoLang = langMap[lang] ?? 'cs';
const src = `https://reservation.previo.cz/?hotId=756911&lang=${previoLang}`;
---

<div class="previo-wrapper">
  <iframe
    src={src}
    class="previo-iframe"
    title="Online rezervace"
    width="100%"
    height="860"
    frameborder="0"
    scrolling="no"
    name="previo-booking-iframe"
    id="previo-booking-iframe"
    allowtransparency="true"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .previo-wrapper {
    width: 100%;
    min-width: 0;
    border-radius: 24px;
    overflow: visible;
    border: 1px solid rgba(28, 34, 38, 0.08);
    background: #fff;
  }

  .previo-iframe {
    display: block;
    width: 100%;
    height: 860px;
    border: none;
    background: #fff;
  }

  @media (max-width: 820px) {
    .previo-iframe {
      height: 980px;
    }
  }
</style>
