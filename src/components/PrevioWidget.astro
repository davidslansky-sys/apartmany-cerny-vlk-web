---
interface Props {
  lang?: 'cs' | 'de' | 'en';
}

const { lang = 'cs' } = Astro.props;

const langMap = {
  cs: 'cs',
  de: 'de',
  en: 'en',
};

const previoLang = langMap[lang] ?? 'cs';

/*
  Používáme aktuální doménu z dokumentace Previo.
  Parametr v přidává jen unikátní identifikaci jazyka do URL,
  nepřidává cache-busting při každém načtení stránky.
*/
const src = `https://booking.previo.app/?hotId=756911&lang=${previoLang}`;
---

<div class="previo-wrapper">
  <!--
    Tento skript je důležitý:
    Previo přes něj automaticky přizpůsobuje výšku iframe obsahu rezervace.
  -->
  <script
    is:inline
    type="text/javascript"
    src="https://booking.previo.app/iframe/"
  ></script>

  <iframe
    src={src}
    class="previo-iframe"
    title="Online rezervace Apartmány Černý vlk"
    width="100%"
    height="2000"
    frameborder="0"
    scrolling="no"
    name="previo-booking-iframe"
    id="previo-booking-iframe"
    allowtransparency="true"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .previo-wrapper {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(28, 34, 38, 0.08);
    border-radius: 24px;
    overflow: visible;
    background: #fff;
  }

  .previo-iframe {
    display: block;
    width: 100%;
    min-width: 0;
    border: 0;
    background: #fff;
  }
</style>
