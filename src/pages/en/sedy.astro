---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PrevioWidget from '../../components/PrevioWidget.astro';
---

<BaseLayout
  lang="en"
  title="Grey apartment – up to 5 guests, 56 m² | Apartmány Černý vlk"
  description="Comfortable apartment in house no. 117 for up to 5 guests. Two bedrooms, a thoughtful layout, west and north orientation, Rituals cosmetics and individual temperature control in every room."
  image="/images/apartmany/sedy/sedy-01.jpg"
>
  <Header />

  <section class="apartment-hero">
    <div class="apartment-hero__media">
      <img
        src="/images/apartmany/sedy/sedy-01.jpg"
        alt="Grey apartment – main living area"
        width="1600"
        height="900"
        loading="eager"
      />
      <div class="apartment-hero__overlay"></div>
    </div>

    <div class="apartment-hero__content">
      <p class="apartment-hero__eyebrow">Apartment in house no. 117</p>
      <h1>Grey apartment</h1>
      <p class="apartment-hero__lead">
        An elegant apartment for guests looking for peace, a higher level of comfort and thoughtful amenities
        in one of the two more luxurious apartments in the complex, with Rituals cosmetics
        and the option to control the temperature in each room individually.
      </p>

      <div class="apartment-hero__actions">
        <a href="#rezervace" class="apartment-hero-btn apartment-hero-btn--primary">Check availability</a>
        <a href="#galerie" class="apartment-hero-btn apartment-hero-btn--ghost">View photos</a>
      </div>
    </div>
  </section>

  <section class="apartment-facts">
    <div class="section-inner">
      <div class="facts-grid facts-grid--simple">
        <div class="fact-card">
          <span class="fact-label">Size</span>
          <strong>56 m²</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Capacity</span>
          <strong>Up to 5 guests</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Bedrooms</span>
          <strong>2 bedrooms</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="apartment-intro">
    <div class="section-inner apartment-intro__grid">
      <div>
        <p class="section-label">Who it is ideal for</p>
        <h2 class="section-title">When you are looking for more comfort and a <em>calmer stay atmosphere</em>.</h2>
      </div>

      <div class="apartment-copy">
        <p>
          The Grey apartment is suitable for guests who want not only practical accommodation during their stay in Šumava,
          but also a higher level of comfort, a calm atmosphere and carefully refined details.
        </p>
        <p>
          Thanks to its west and north orientation, the apartment has a pleasant light character in the afternoon and evening,
          while still keeping a calmer and more balanced atmosphere even on warmer days.
        </p>
        <p>
          Compared to the apartments in house 116, guests here will also appreciate premium features such as Rituals cosmetics
          and the option to regulate the temperature independently in every room.
        </p>
      </div>
    </div>
  </section>

  <section class="apartment-layout">
    <div class="section-inner">
      <p class="section-label">Layout</p>
      <h2 class="section-title">A layout that combines comfort and <em>practical everyday use</em></h2>

      <div class="layout-grid">
        <article class="layout-card">
          <div class="layout-card__text">
            <h3>Ground floor</h3>
            <p>
              The ground floor contains the shared area with kitchen, which forms the main living space of the apartment
              and the natural centre of time spent together during the stay.
            </p>
            <p>
              The ground floor also includes a separate toilet and storage room, which adds greater comfort
              and practical convenience for both shorter and longer stays.
            </p>
            <p>
              The entire ground floor feels airy and clear and offers a pleasant setting for shared breakfasts,
              returning from trips and quiet evenings after a day spent in Šumava.
            </p>
          </div>

          <div class="layout-card__media" data-gallery="sedy-pudorysy">
            <button
              type="button"
              class="gallery-item gallery-item--plan"
              data-gallery-trigger="true"
              data-gallery-index="0"
              aria-label="Open ground floor plan of house 117"
            >
              <img
                src="/images/domy/dum-117/dum-117-pudorys-prizemi.jpg"
                alt="Ground floor plan of house 117"
                width="1200"
                height="900"
                loading="lazy"
              />
            </button>
          </div>
        </article>

        <article class="layout-card">
          <div class="layout-card__text">
            <h3>First floor</h3>
            <p>
              The first floor includes two separate bedrooms that create the quiet part of the apartment,
              separated from daily life on the ground floor and providing more privacy for all guests.
            </p>
            <p>
              There is also a bathroom with shower and toilet, so the upper floor offers full
              and comfortable facilities for everyday use during the stay.
            </p>
            <p>
              Thanks to this arrangement, the apartment feels balanced, compact and still comfortable,
              and it works well even for several guests.
            </p>
          </div>

          <div class="layout-card__media" data-gallery="sedy-pudorysy">
            <button
              type="button"
              class="gallery-item gallery-item--plan"
              data-gallery-trigger="true"
              data-gallery-index="1"
              aria-label="Open first floor plan of house 117"
            >
              <img
                src="/images/domy/dum-117/dum-117-pudorys-1patro.jpg"
                alt="First floor plan of house 117"
                width="1200"
                height="900"
                loading="lazy"
              />
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="apartment-highlights">
    <div class="section-inner">
      <p class="section-label">Highlights</p>
      <h2 class="section-title">What makes the Grey apartment an <em>exceptionally pleasant choice</em></h2>

      <div class="highlights-grid">
        <article class="highlight-card">
          <h3>One of the two more luxurious apartments</h3>
          <p>
            The Grey apartment is intended for guests who want more comfort, a calmer atmosphere
            and thoughtful details that reflect a higher accommodation standard.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Two separate bedrooms</h3>
          <p>
            Separate sleeping areas increase comfort and privacy for a family, two couples or a smaller group of guests.
          </p>
        </article>

        <article class="highlight-card">
          <h3>West and north orientation</h3>
          <p>
            The apartment has a pleasant afternoon and evening light character, while still maintaining
            a calmer atmosphere and a comfortable interior environment.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Part of house no. 117</h3>
          <p>
            The Grey apartment is located in house 117, the building where the more luxurious apartments
            with their own character and layouts are situated.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Temperature control in every room</h3>
          <p>
            Guests can set the temperature independently in each room, which brings extra comfort
            during winter and transitional seasons.
          </p>
        </article>

        <article class="highlight-card">
          <h3>Rituals cosmetics</h3>
          <p>
            The higher level of comfort during the stay is complemented by Rituals cosmetics,
            which underline the apartment’s overall more premium character.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="apartment-gallery" id="galerie">
    <div class="section-inner">
      <div class="gallery-heading">
        <div>
          <p class="section-label">Gallery</p>
          <h2 class="section-title">Take a look <em>inside</em></h2>
        </div>
        <p class="gallery-note">
          Complete photo gallery of the Grey apartment. Click any photo to open it in a larger view.
        </p>
      </div>

      <div class="gallery-grid gallery-grid--full" data-gallery="sedy">
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="0" aria-label="Open photo 1">
          <img src="/images/apartmany/sedy/sedy-01.jpg" alt="Grey apartment – photo 1" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="1" aria-label="Open photo 2">
          <img src="/images/apartmany/sedy/sedy-02.jpg" alt="Grey apartment – photo 2" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="2" aria-label="Open photo 3">
          <img src="/images/apartmany/sedy/sedy-03.jpg" alt="Grey apartment – photo 3" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="3" aria-label="Open photo 4">
          <img src="/images/apartmany/sedy/sedy-04.jpg" alt="Grey apartment – photo 4" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="4" aria-label="Open photo 5">
          <img src="/images/apartmany/sedy/sedy-05.jpg" alt="Grey apartment – photo 5" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="5" aria-label="Open photo 6">
          <img src="/images/apartmany/sedy/sedy-06.jpg" alt="Grey apartment – photo 6" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="6" aria-label="Open photo 7">
          <img src="/images/apartmany/sedy/sedy-07.jpg" alt="Grey apartment – photo 7" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="7" aria-label="Open photo 8">
          <img src="/images/apartmany/sedy/sedy-08.jpg" alt="Grey apartment – photo 8" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="8" aria-label="Open photo 9">
          <img src="/images/apartmany/sedy/sedy-09.jpg" alt="Grey apartment – photo 9" width="900" height="700" loading="lazy" />
        </button>

        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="9" aria-label="Open photo 10">
          <img src="/images/apartmany/sedy/sedy-10.jpg" alt="Grey apartment – photo 10" width="900" height="700" loading="lazy" />
        </button>
      </div>
    </div>
  </section>

  <section class="apartment-equipment-link">
    <div class="section-inner">
      <div class="equipment-link__stack">
        <p class="section-label">Amenities</p>
        <h2 class="section-title">Need to know the amenity details? <em>You can find them here.</em></h2>
        <div class="equipment-link__action equipment-link__action--below">
          <a href="/en/vybaveni/" class="btn-secondary">Go to the amenities page</a>
        </div>
      </div>
    </div>
  </section>

  <section class="apartment-booking" id="rezervace">
    <div class="section-inner booking-layout">
      <div class="booking-copy">
        <p class="section-label">Booking</p>
        <h2 class="section-title">Have you chosen your date? <em>Book online.</em></h2>
        <p>
          You can check availability directly online. If you are planning a stay in several apartments in house 117,
          you can also call or write to us.
        </p>

        <div class="contact-line">
          <div class="contact-item"><span>📞</span><a href="tel:+420728739288">+420 728 739 288</a></div>
          <div class="contact-item"><span>📞</span><a href="tel:+420739753580">+420 739 753 580</a></div>
          <div class="contact-item"><span>✉️</span><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></div>
        </div>
      </div>

      <div>
        <PrevioWidget lang="en" />
      </div>
    </div>
  </section>

  <dialog
    class="lightbox"
    id="gallery-lightbox"
    aria-labelledby="gallery-lightbox-title"
    aria-modal="true"
  >
    <div class="lightbox__panel" role="document">
      <div class="sr-only" id="gallery-lightbox-title">Gallery of the Grey apartment</div>

      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close gallery">
        ×
      </button>

      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous photo">
        ‹
      </button>

      <figure class="lightbox__figure">
        <img
          id="lightbox-image"
          src=""
          alt=""
          width="1600"
          height="1100"
        />
        <figcaption id="lightbox-caption" class="lightbox__caption"></figcaption>
      </figure>

      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next photo">
        ›
      </button>
    </div>
  </dialog>

  <Footer lang="en" />

  <script>
    (() => {
      const dialog = document.getElementById('gallery-lightbox');
      const image = document.getElementById('lightbox-image');
      const caption = document.getElementById('lightbox-caption');
      const prevButton = dialog?.querySelector('[data-lightbox-prev]');
      const nextButton = dialog?.querySelector('[data-lightbox-next]');
      const closeButtons = dialog?.querySelectorAll('[data-lightbox-close]');

      if (!dialog || !image || !caption) return;

      const galleryGroups = new Map();
      const galleryWrappers = Array.from(document.querySelectorAll('[data-gallery]'));

      if (galleryWrappers.length === 0) return;

      galleryWrappers.forEach((wrapper) => {
        const name = wrapper.getAttribute('data-gallery');
        if (!name) return;

        if (!galleryGroups.has(name)) {
          galleryGroups.set(name, []);
        }

        const buttons = Array.from(wrapper.querySelectorAll('[data-gallery-index]'));
        buttons.forEach((button) => {
          galleryGroups.get(name).push(button);
        });
      });

      let currentGalleryItems = [];
      let currentIndex = 0;
      let lastTrigger = null;

      const buildItems = (galleryName) => {
        const buttons = galleryGroups.get(galleryName) || [];
        return buttons
          .sort((a, b) => Number(a.getAttribute('data-gallery-index')) - Number(b.getAttribute('data-gallery-index')))
          .map((button) => {
            const img = button.querySelector('img');
            return {
              src: img?.getAttribute('src') || '',
              alt: img?.getAttribute('alt') || '',
              trigger: button,
            };
          });
      };

      const renderItem = (index) => {
        const item = currentGalleryItems[index];
        if (!item) return;
        currentIndex = index;
        image.src = item.src;
        image.alt = item.alt;
        caption.textContent = item.alt;
      };

      const openLightbox = (galleryName, index, trigger) => {
        currentGalleryItems = buildItems(galleryName);
        lastTrigger = trigger || null;
        renderItem(index);

        if (typeof dialog.showModal === 'function' && !dialog.open) {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', 'true');
        }

        document.documentElement.classList.add('lightbox-open');
      };

      const closeLightbox = () => {
        if (typeof dialog.close === 'function' && dialog.open) {
          dialog.close();
        } else {
          dialog.removeAttribute('open');
        }

        document.documentElement.classList.remove('lightbox-open');

        if (lastTrigger) {
          lastTrigger.focus();
        }
      };

      const showPrev = () => {
        if (currentGalleryItems.length === 0) return;
        const nextIndex = currentIndex === 0 ? currentGalleryItems.length - 1 : currentIndex - 1;
        renderItem(nextIndex);
      };

      const showNext = () => {
        if (currentGalleryItems.length === 0) return;
        const nextIndex = currentIndex === currentGalleryItems.length - 1 ? 0 : currentIndex + 1;
        renderItem(nextIndex);
      };

      galleryWrappers.forEach((gallery) => {
        gallery.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const trigger = target.closest('[data-gallery-index]');
          if (!trigger) return;

          event.preventDefault();

          const index = Number(trigger.getAttribute('data-gallery-index'));
          if (Number.isNaN(index)) return;

          const galleryName = gallery.getAttribute('data-gallery');
          if (!galleryName) return;

          openLightbox(galleryName, index, trigger);
        });
      });

      prevButton?.addEventListener('click', (event) => {
        event.preventDefault();
        showPrev();
      });

      nextButton?.addEventListener('click', (event) => {
        event.preventDefault();
        showNext();
      });

      closeButtons?.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          closeLightbox();
        });
      });

      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeLightbox();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showPrev();
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showNext();
        }

        if (event.key === 'Escape') {
          event.preventDefault();
          closeLightbox();
        }
      });
    })();
  </script>

  <style>
    .apartment-hero {
      position: relative;
      min-height: 82svh;
      display: grid;
      align-items: end;
      overflow: clip;
      background: var(--color-bg);
    }

    .apartment-hero__media {
      position: absolute;
      inset: 0;
    }

    .apartment-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .apartment-hero__overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(12, 14, 12, 0.7) 0%, rgba(12, 14, 12, 0.28) 42%, rgba(12, 14, 12, 0.12) 100%);
    }

    .apartment-hero__content {
      position: relative;
      z-index: 2;
      width: min(100%, 880px);
      padding: clamp(6rem, 10vw, 9rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
      margin-inline: auto;
      color: #f8f3eb;
    }

    .apartment-hero__eyebrow,
    .section-label {
      margin: 0 0 0.85rem;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(248, 243, 235, 0.78);
    }

    .section-label {
      color: var(--color-muted);
    }

    .apartment-hero h1 {
      margin: 0;
      font-size: clamp(2.8rem, 7vw, 5.8rem);
      line-height: 0.94;
      letter-spacing: -0.03em;
      color: #f8f3eb;
    }

    .apartment-hero__lead {
      max-width: 44rem;
      margin: 1.5rem 0 0;
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.75;
      color: rgba(248, 243, 235, 0.88);
    }

    .apartment-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .apartment-hero-btn,
    .apartment-hero-btn:link,
    .apartment-hero-btn:visited,
    .btn-primary,
    .btn-ghost,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      padding: 0.85rem 1.2rem;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .apartment-hero-btn--primary,
    .apartment-hero-btn--primary:link,
    .apartment-hero-btn--primary:visited {
      background-color: #6f8f6b;
      border: 1px solid #6f8f6b;
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(30, 40, 30, 0.18);
    }

    .apartment-hero-btn--primary:hover,
    .apartment-hero-btn--primary:focus-visible {
      background-color: #5f7d5b;
      border-color: #5f7d5b;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(30, 40, 30, 0.22);
    }

    .apartment-hero-btn--primary:active {
      transform: translateY(0);
      background-color: #557051;
      border-color: #557051;
      color: #ffffff;
    }

    .apartment-hero-btn--ghost,
    .apartment-hero-btn--ghost:link,
    .apartment-hero-btn--ghost:visited {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #fff;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: none;
    }

    .apartment-hero-btn--ghost:hover,
    .apartment-hero-btn--ghost:focus-visible {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.42);
      color: #fff;
      transform: translateY(-1px);
    }

    .apartment-hero-btn--ghost:active {
      transform: translateY(0);
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.5);
      color: #fff;
    }

    .section-inner {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .apartment-facts,
    .apartment-intro,
    .apartment-layout,
    .apartment-highlights,
    .apartment-gallery,
    .apartment-equipment-link,
    .apartment-booking {
      padding: clamp(4.5rem, 7vw, 7rem) 0;
    }

    .apartment-facts {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .facts-grid {
      display: grid;
      gap: 1rem;
    }

    .facts-grid--simple {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 780px;
      margin-inline: auto;
    }

    .fact-card {
      padding: 1.25rem 1rem;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: 1.2rem;
      text-align: center;
    }

    .fact-label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .fact-card strong {
      font-size: 1.08rem;
      line-height: 1.4;
      color: var(--color-text);
    }

    .apartment-intro__grid,
    .booking-layout {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .section-title {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .section-title em {
      display: inline-block;
      font-style: italic;
      font-weight: 500;
      opacity: 0.9;
      line-height: 1.14;
      padding-right: 0.08em;
      padding-bottom: 0.08em;
    }

    .apartment-copy p,
    .layout-card__text p,
    .highlight-card p,
    .gallery-note,
    .booking-copy p {
      margin: 0 0 1rem;
      font-size: 1.04rem;
      line-height: 1.85;
      color: var(--color-text);
    }

    .layout-grid {
      display: grid;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .layout-card {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 1.5rem;
      padding: 1.35rem;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: 1.5rem;
    }

    .layout-card__text h3,
    .highlight-card h3 {
      margin: 0 0 0.9rem;
      font-size: 1.4rem;
      line-height: 1.15;
      color: var(--color-heading);
    }

    .layout-card__media img,
    .gallery-item img,
    .lightbox__figure img {
      width: 100%;
      border-radius: 1rem;
      border: 1px solid var(--color-border);
