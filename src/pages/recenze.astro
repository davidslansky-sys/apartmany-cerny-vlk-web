---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const reviewSources = [
  {
    name: 'Booking.com',
    value: '9,4 / 10',
    count: '98 hodnocení',
    href: 'https://www.booking.com/hotel/cz/apartmany-cerny-vlk-borova-lada.cs.html',
  },
  {
    name: 'Google.com',
    value: '4,9 / 5',
    count: '93 hodnocení',
    href: 'https://www.google.com/search?sca_esv=0e07b4d6a31d3a97&q=Apartm%C3%A1ny+%C4%8Cern%C3%BD+vlk+Borov%C3%A1+Lada+recenze',
  },
  {
    name: 'Mapy.com',
    value: '5,0 / 5',
    count: '24 hodnocení',
    href: 'https://mapy.com/s/pozarucuzu',
  },
  {
    name: 'Previo.cz',
    value: '9,7 / 10',
    count: '84 hodnocení',
    href: 'https://www.previo.cz/ubytovani/borova-lada/25765-apartmany-cerny-vlk#hodnoceni',
  },
];

const selectedReviews = [
  {
    platform: 'Booking.com',
    author: 'Dagmar',
    country: 'ČR',
    date: 'srpen 2025',
    text: 'Skvělé, moderní ubytování, vyladěné do nejmenších detailů. Klidné místo a lokalita ideální k řadě výletů a aktivit přímo v Borových Ladech, případně v rozumné vzdálenosti. Velmi vstřícní a ochotní majitelé. Vřele doporučujeme a rádi se zase vrátíme ☺️',
  },
  {
    platform: 'Booking.com',
    author: 'Hunor',
    country: 'Německo',
    date: 'listopad 2025',
    text: 'Krásná lokalita, stylový dům i apartmány, bezklíčový vstup na kód, přímé napojení na okolní přírodu, dobře vybavená kuchyně a praktická skladovací místnost.',
  },
  {
    platform: 'Google.com',
    author: 'Tomáš',
    country: 'ČR',
    date: 'prosinec 2025',
    text: 'Apartmány jsou nové, hezky útulně zařízené. Domácí mazlíčci jsou vítáni. Dovolenou jsme si užili, jezdíme na Šumavu pravidelně za turistikou s naším mazlíčkem, takže vše dle očekávání.',
  },
  {
    platform: 'Google.com',
    author: 'Helena',
    country: 'ČR',
    date: 'léto 2025',
    text: 'Apartmán je vkusně zařízený, čistý, moc příjemný. Poloha výborná. Byly jsme se malými dětmi a moc jsme si to užili.',
  },
  {
    platform: 'Mapy.com',
    author: 'Petra',
    country: 'ČR',
    date: 'únor 2026',
    text: 'Nádherný plně vybavený apartmán, moc se nám tu líbilo, určitě se sem budeme vracet.',
  },
  {
    platform: 'Previo.cz',
    author: 'Jindřiška',
    country: 'ČR',
    date: 'březen 2025',
    text: 'Žlutý apartmán – skvělý apartmán pro 5 lidí a pejska. Dispozičně skvěle řešeno, uvítali jsme 2x WC :) Vybavenost apartmánu opět na výborné úrovni – de facto nám zde nechybělo nic, od vybavení kuchyně po ručníky až po vysoušeč bot. Apartmán má i svoji vlastní lyžárnu, kam je možnost uložit i náhradní boty. Skvělá poloha – na Kvildě jste do 10 minutek. Paní správcová velice milá, řeší problémy ihned, pokud vůbec nějaké nastanou. Opravdu za nás můžeme jen a jen doporučit.',
  },
];
---

<BaseLayout
  lang="cs"
  title="Recenze hostů | Apartmány Černý vlk"
  description="Zkušenosti hostů a hodnocení z Booking.com, Google.com, Mapy.com a Previo.cz."
>
  <Header />

  <section class="reviews-hero">
    <div class="reviews-hero__media">
      <img
        src="/images/hero/hero-borova-lada.jpg"
        alt="Borová Lada a okolní šumavská krajina"
        width="1600"
        height="900"
        loading="eager"
      />
      <div class="reviews-hero__overlay"></div>
    </div>

    <div class="section-inner reviews-hero__grid">
      <div class="reviews-hero__content">
        <p class="section-label section-label--hero">Recenze hostů</p>
        <h1>
          Zkušenosti hostů
          <em>z Booking.com, Google.com, Mapy.com a Previo.cz</em>
        </h1>
        <p class="reviews-hero__lead">
          Na jednom místě najdete souhrnné hodnocení i konkrétní zkušenosti hostů,
          kteří u nás pobývali v různých termínech a sdíleli své dojmy veřejně
          na hlavních rezervačních a recenzních platformách.
        </p>
      </div>

      <aside class="reviews-summary-card" aria-label="Souhrnné hodnocení">
        <div class="reviews-summary-card__score">9,4</div>
        <p class="reviews-summary-card__text">
          Souhrnné hodnocení napříč hlavními platformami a veřejně dostupnými recenzemi hostů.
        </p>
      </aside>
    </div>
  </section>

  <section class="reviews-platforms">
    <div class="section-inner">
      <p class="section-label">Platformy</p>
      <h2 class="section-title">Hodnocení na <em>jednotlivých platformách</em></h2>

      <div class="platform-grid">
        {reviewSources.map((source) => (
          <a
            class="platform-card"
            href={source.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Otevřít recenze na platformě ${source.name}`}
          >
            <div class="platform-card__top">
              <h3>{source.name}</h3>
              <span class="platform-card__value">{source.value}</span>
            </div>
            <p class="platform-card__count">{source.count}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-selected">
    <div class="section-inner">
      <p class="section-label">Vybrané recenze</p>
      <h2 class="section-title">Konkrétní zkušenosti <em>našich hostů</em></h2>

      <div class="selected-reviews-grid">
        {selectedReviews.map((review) => (
          <article class="selected-review-card">
            <div class="selected-review-card__meta">
              <span class="selected-review-card__platform">{review.platform}</span>
              <span class="selected-review-card__author">
                <strong>{review.author}</strong> · {review.country} · {review.date}
              </span>
            </div>
            <p class="selected-review-card__text">„{review.text}“</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-cta">
    <div class="section-inner reviews-cta__inner">
      <div>
        <p class="section-label">Rezervace</p>
        <h2 class="section-title">Chcete si udělat <em>vlastní zkušenost</em>?</h2>
        <p class="reviews-cta__text">
          Podívejte se na dostupné termíny a vyberte si apartmán, který vám bude nejlépe vyhovovat.
        </p>
      </div>

      <div class="reviews-cta__actions">
        <a href="/#rezervace" class="btn-primary">Zkontrolovat dostupnost</a>
        <a href="/apartmany" class="btn-secondary">Prohlédnout apartmány</a>
      </div>
    </div>
  </section>

  <Footer lang="cs" />

  <style>
    .section-inner {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .section-label {
      margin: 0 0 0.85rem;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .section-label--hero {
      color: rgba(248, 243, 235, 0.76);
    }

    .section-title {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .section-title em,
    .reviews-hero h1 em {
      display: inline-block;
      font-style: italic;
      font-weight: 500;
      opacity: 0.92;
      line-height: 1.14;
      padding-right: 0.08em;
      padding-bottom: 0.08em;
    }

    .reviews-hero,
    .reviews-platforms,
    .reviews-selected,
    .reviews-cta {
      padding: clamp(4.5rem, 7vw, 7rem) 0;
    }

    .reviews-hero {
      position: relative;
      min-height: 72svh;
      display: grid;
      align-items: end;
      overflow: clip;
      background: #111;
      color: #f8f3eb;
    }

    .reviews-hero__media {
      position: absolute;
      inset: 0;
    }

    .reviews-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .reviews-hero__overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(12, 14, 12, 0.78) 0%, rgba(12, 14, 12, 0.34) 42%, rgba(12, 14, 12, 0.16) 100%);
    }

    .reviews-hero__grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, 380px);
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: end;
    }

    .reviews-hero__content {
      padding: clamp(6rem, 10vw, 9rem) 0 clamp(2.5rem, 5vw, 4rem);
    }

    .reviews-hero h1 {
      margin: 0;
      max-width: 12ch;
      font-size: clamp(2.9rem, 7vw, 5.6rem);
      line-height: 0.94;
      letter-spacing: -0.04em;
      color: #f8f3eb;
    }

    .reviews-hero__lead {
      max-width: 46rem;
      margin: 1.5rem 0 0;
      font-size: clamp(1.04rem, 2vw, 1.2rem);
      line-height: 1.8;
      color: rgba(248, 243, 235, 0.88);
    }

    .reviews-summary-card {
      margin-bottom: clamp(2.5rem, 5vw, 4rem);
      padding: 1.6rem;
      border-radius: 1.5rem;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.16);
    }

    .reviews-summary-card__score {
      font-size: clamp(3.6rem, 8vw, 5.4rem);
      line-height: 0.95;
      font-weight: 700;
      letter-spacing: -0.05em;
      color: #ffffff;
    }

    .reviews-summary-card__text {
      margin: 0.9rem 0 0;
      font-size: 1rem;
      line-height: 1.7;
      color: rgba(248, 243, 235, 0.84);
    }

    .reviews-platforms {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .platform-card {
      display: block;
      padding: 1.35rem;
      border-radius: 1.3rem;
      border: 1px solid var(--color-border);
      background: var(--color-card);
      text-decoration: none;
      color: inherit;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease;
    }

    .platform-card:hover,
    .platform-card:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
    }

    .platform-card__top {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: 1rem;
    }

    .platform-card h3 {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.3;
      color: var(--color-heading);
    }

    .platform-card__value {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-text);
      white-space: nowrap;
    }

    .platform-card__count {
      margin: 0.75rem 0 0;
      color: var(--color-muted);
      line-height: 1.6;
    }

    .selected-reviews-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .selected-review-card {
      padding: 1.5rem;
      border-radius: 1.4rem;
      border: 1px solid var(--color-border);
      background: var(--color-card);
    }

    .selected-review-card__meta {
      display: grid;
      gap: 0.35rem;
      margin-bottom: 1rem;
    }

    .selected-review-card__platform {
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .selected-review-card__author {
      font-size: 0.98rem;
      line-height: 1.5;
      color: var(--color-text);
    }

    .selected-review-card__text {
      margin: 0;
      font-size: 1.04rem;
      line-height: 1.85;
      color: var(--color-text);
    }

    .reviews-cta {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .reviews-cta__inner {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: center;
    }

    .reviews-cta__text {
      max-width: 42rem;
      margin: 1rem 0 0;
      font-size: 1.04rem;
      line-height: 1.8;
      color: var(--color-text);
    }

    .reviews-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: center;
      justify-content: flex-end;
    }

    .btn-primary,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      padding: 0.85rem 1.2rem;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .btn-primary,
    .btn-primary:link,
    .btn-primary:visited {
      background-color: #6f8f6b;
      border: 1px solid #6f8f6b;
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(30, 40, 30, 0.18);
    }

    .btn-primary:hover,
    .btn-primary:focus-visible {
      background-color: #5f7d5b;
      border-color: #5f7d5b;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(30, 40, 30, 0.22);
    }

    .btn-secondary,
    .btn-secondary:link,
    .btn-secondary:visited {
      border: 1px solid var(--color-border);
      color: var(--color-text);
      background: transparent;
    }

    .btn-secondary:hover,
    .btn-secondary:focus-visible {
      background: var(--color-card);
      transform: translateY(-1px);
    }

    @media (max-width: 1100px) {
      .platform-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .selected-reviews-grid {
        grid-template-columns: 1fr;
      }

      .reviews-hero__grid,
      .reviews-cta__inner {
        grid-template-columns: 1fr;
        display: grid;
      }

      .reviews-summary-card {
        margin-bottom: 0;
      }

      .reviews-cta__actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 720px) {
      .platform-grid {
        grid-template-columns: 1fr;
      }

      .reviews-summary-card {
        padding: 1.25rem;
      }

      .reviews-hero {
        min-height: auto;
      }

      .reviews-hero__content {
        padding: 6rem 0 2rem;
      }

      .reviews-hero h1 {
        max-width: none;
        font-size: clamp(2.4rem, 12vw, 4rem);
      }

      .reviews-cta__actions {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
