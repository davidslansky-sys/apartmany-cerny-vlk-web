---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PrevioWidget from '../../../components/PrevioWidget.astro';
---

<BaseLayout
  lang="de"
  title="Grünes Apartment – 4+1 Personen, 56 m² | Apartmány Černý vlk"
  description="Komfortables Apartment im Haus Nr. 116 für 4 bis 5 Personen. Zwei Schlafzimmer, ein praktischer Grundriss und eine Nord-Ost-Ausrichtung für einen angenehmen Aufenthalt im Böhmerwald."
  image="/images/apartmany/zeleny/zeleny-01.jpg"
>
  <Header />

  <section class="apartment-hero">
    <div class="apartment-hero__media">
      <img
        src="/images/apartmany/zeleny/zeleny-01.jpg"
        alt="Grünes Apartment – Hauptwohnbereich"
        width="1600"
        height="900"
        loading="eager"
      />
      <div class="apartment-hero__overlay"></div>
    </div>

    <div class="apartment-hero__content">
      <p class="apartment-hero__eyebrow">Apartment im Haus Nr. 116</p>
      <h1>Grünes Apartment</h1>
      <p class="apartment-hero__lead">
        Ein praktisch gestaltetes Apartment für eine Familie oder eine kleinere Gruppe von Gästen, die eine ruhige Unterkunft,
        zwei separate Schlafzimmer und einen komfortablen Aufenthalt im Herzen des Böhmerwalds suchen.
      </p>

      <div class="apartment-hero__actions">
        <a href="#rezervace" class="apartment-hero-btn apartment-hero-btn--primary">Verfügbarkeit prüfen</a>
        <a href="#galerie" class="apartment-hero-btn apartment-hero-btn--ghost">Fotos ansehen</a>
      </div>
    </div>
  </section>

  <section class="apartment-facts">
    <div class="section-inner">
      <div class="facts-grid facts-grid--simple">
        <div class="fact-card">
          <span class="fact-label">Größe</span>
          <strong>56 m²</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Kapazität</span>
          <strong>4+1 Personen</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Schlafzimmer</span>
          <strong>2 Schlafzimmer</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="apartment-intro">
    <div class="section-inner apartment-intro__grid">
      <div>
        <p class="section-label">Für wen es ideal ist</p>
        <h2 class="section-title">Wenn Sie Komfort für <em>Familie und einen ruhigen Aufenthalt</em> suchen.</h2>
      </div>

      <div class="apartment-copy">
        <p>
          Das Grüne Apartment eignet sich für Familien mit Kindern, zwei Paare oder eine kleinere Gruppe von Gästen,
          die während ihres Aufenthalts genügend Komfort und zugleich einen praktisch gestalteten Raum schätzen.
        </p>
        <p>
          Dank der Ausrichtung nach Norden und Osten wirkt das Apartment frisch und ruhig und bietet ein angenehmes Tageslicht,
          besonders in den Morgen- und Vormittagsstunden.
        </p>
        <p>
          Der Grundriss ist für ein komfortables Wochenende ebenso wie für einen längeren Urlaub ausgelegt, bei dem Sie getrennte Schlafzimmer,
          einen gemeinsamen Wohnbereich und eine Ausstattung schätzen, die im Alltag gut funktioniert.
        </p>
      </div>
    </div>
  </section>

  <section class="apartment-layout">
    <div class="section-inner">
      <p class="section-label">Grundriss</p>
      <h2 class="section-title">Praktischer Raum für einen <em>angenehmen Aufenthalt</em></h2>

      <div class="layout-grid">
        <article class="layout-card">
          <div class="layout-card__text">
            <h3>Erdgeschoss</h3>
            <p>
              Im Erdgeschoss befindet sich der Gemeinschaftsbereich mit Küche, der den Hauptwohnbereich des Apartments bildet
              und ein natürlicher Ort für gemeinsame Zeit während des Aufenthalts ist.
            </p>
            <p>
              Zum Erdgeschoss gehören auch eine separate Toilette und ein Abstellraum, sodass das Apartment praktische Ausstattung
              auch für längere Aufenthalte oder einen aktiven Urlaub im Böhmerwald bietet.
            </p>
            <p>
              Der Grundriss des Erdgeschosses ist klar, funktional und eignet sich gut für den Alltag einer Familie oder einer kleineren Gruppe von Gästen.
            </p>
          </div>

          <div class="layout-card__media" data-gallery="zeleny-pudorysy">
            <button
              type="button"
              class="gallery-item gallery-item--plan"
              data-gallery-trigger="true"
              data-gallery-index="0"
              aria-label="Grundriss des Erdgeschosses von Haus 116 öffnen"
            >
              <img
                src="/images/domy/dum-116/dum-116-pudorys-prizemi.jpg"
                alt="Grundriss des Erdgeschosses von Haus 116"
                width="1200"
                height="900"
                loading="lazy"
              />
            </button>
          </div>
        </article>

        <article class="layout-card">
          <div class="layout-card__text">
            <h3>1. Obergeschoss</h3>
            <p>
              Im ersten Obergeschoss befinden sich zwei Schlafzimmer, die den ruhigen Teil des Apartments bilden und vom täglichen Leben im Erdgeschoss getrennt sind.
            </p>
            <p>
              Hier finden Sie auch ein Badezimmer mit Dusche und WC, was einen komfortablen Aufenthalt für Familien und Gäste ermöglicht,
              die alles praktisch zur Hand haben möchten.
            </p>
            <p>
              Dank dieser Aufteilung wirkt das Apartment kompakt, bietet aber gleichzeitig auch bei mehreren Personen eine komfortable Raumaufteilung.
            </p>
          </div>

          <div class="layout-card__media" data-gallery="zeleny-pudorysy">
            <button
              type="button"
              class="gallery-item gallery-item--plan"
              data-gallery-trigger="true"
              data-gallery-index="1"
              aria-label="Grundriss des ersten Obergeschosses von Haus 116 öffnen"
            >
              <img
                src="/images/domy/dum-116/dum-116-pudorys-1patro.jpg"
                alt="Grundriss des ersten Obergeschosses von Haus 116"
                width="1200"
                height="900"
                loading="lazy"
              />
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="apartment-highlights">
    <div class="section-inner">
      <p class="section-label">Vorteile</p>
      <h2 class="section-title">Was das Grüne Apartment zu einer <em>angenehmen Wahl</em> macht</h2>

      <div class="highlights-grid">
        <article class="highlight-card">
          <h3>Ideal für 4 bis 5 Gäste</h3>
          <p>Größe und Grundriss funktionieren gut für Familien, zwei Paare oder eine kleinere Gruppe, die zusammen sein und zugleich komfortabel wohnen möchten.</p>
        </article>

        <article class="highlight-card">
          <h3>Zwei separate Schlafzimmer</h3>
          <p>Getrennte Schlafräume erhöhen den Komfort und bieten mehr Privatsphäre bei kurzen ebenso wie bei längeren Aufenthalten.</p>
        </article>

        <article class="highlight-card">
          <h3>Nordost-Ausrichtung</h3>
          <p>Das Apartment wirkt frisch und ruhig und bietet ein angenehmes Tageslicht besonders in den Morgen- und Vormittagsstunden.</p>
        </article>

        <article class="highlight-card">
          <h3>Teil des Hauses Nr. 116</h3>
          <p>Das Grüne Apartment befindet sich im selben Haus wie das Rote und das Gelbe Apartment und eignet sich daher auch für kombinierte Buchungen mehrerer Apartments.</p>
        </article>

        <article class="highlight-card">
          <h3>Praktische Größe</h3>
          <p>56 m² bieten ein ausgewogenes Verhältnis zwischen Komfort, Privatsphäre und unkompliziertem Wohnen während des gesamten Aufenthalts.</p>
        </article>

        <article class="highlight-card">
          <h3>Gute Wahl für längere Aufenthalte</h3>
          <p>Dank der vollwertigen Ausstattung und des durchdachten Grundrisses wohnt es sich hier nicht nur am Wochenende, sondern auch während eines längeren Urlaubs sehr angenehm.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="apartment-gallery" id="galerie">
    <div class="section-inner">
      <div class="gallery-heading">
        <div>
          <p class="section-label">Galerie</p>
          <h2 class="section-title">Werfen Sie einen Blick <em>ins Innere</em></h2>
        </div>
        <p class="gallery-note">
          Komplette Fotogalerie des Grünen Apartments. Klicken Sie auf ein Bild, um es größer anzuzeigen.
        </p>
      </div>

      <div class="gallery-grid gallery-grid--full" data-gallery="zeleny">
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="0" aria-label="Foto 1 öffnen"><img src="/images/apartmany/zeleny/zeleny-01.jpg" alt="Grünes Apartment – Foto 1" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="1" aria-label="Foto 2 öffnen"><img src="/images/apartmany/zeleny/zeleny-02.jpg" alt="Grünes Apartment – Foto 2" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="2" aria-label="Foto 3 öffnen"><img src="/images/apartmany/zeleny/zeleny-03.jpg" alt="Grünes Apartment – Foto 3" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="3" aria-label="Foto 4 öffnen"><img src="/images/apartmany/zeleny/zeleny-04.jpg" alt="Grünes Apartment – Foto 4" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="4" aria-label="Foto 5 öffnen"><img src="/images/apartmany/zeleny/zeleny-05.jpg" alt="Grünes Apartment – Foto 5" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="5" aria-label="Foto 6 öffnen"><img src="/images/apartmany/zeleny/zeleny-06.jpg" alt="Grünes Apartment – Foto 6" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="6" aria-label="Foto 7 öffnen"><img src="/images/apartmany/zeleny/zeleny-07.jpg" alt="Grünes Apartment – Foto 7" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="7" aria-label="Foto 8 öffnen"><img src="/images/apartmany/zeleny/zeleny-08.jpg" alt="Grünes Apartment – Foto 8" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="8" aria-label="Foto 9 öffnen"><img src="/images/apartmany/zeleny/zeleny-09.jpg" alt="Grünes Apartment – Foto 9" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="9" aria-label="Foto 10 öffnen"><img src="/images/apartmany/zeleny/zeleny-10.jpg" alt="Grünes Apartment – Foto 10" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="10" aria-label="Foto 11 öffnen"><img src="/images/apartmany/zeleny/zeleny-11.jpg" alt="Grünes Apartment – Foto 11" width="900" height="700" loading="lazy" /></button>
        <button type="button" class="gallery-item" data-gallery-trigger="true" data-gallery-index="11" aria-label="Foto 12 öffnen"><img src="/images/apartmany/zeleny/zeleny-12.jpg" alt="Grünes Apartment – Foto 12" width="900" height="700" loading="lazy" /></button>
      </div>
    </div>
  </section>

  <section class="apartment-equipment-link">
    <div class="section-inner">
      <div class="equipment-link__stack">
        <p class="section-label">Ausstattung</p>
        <h2 class="section-title">Möchten Sie die Ausstattungsdetails kennen? <em>Hier finden Sie sie.</em></h2>
        <div class="equipment-link__action equipment-link__action--below">
          <a href="/de/vybaveni" class="btn-secondary">Zur Ausstattungsseite</a>
        </div>
      </div>
    </div>
  </section>

  <section class="apartment-booking" id="rezervace">
    <div class="section-inner booking-layout">
      <div class="booking-copy">
        <p class="section-label">Reservierung</p>
        <h2 class="section-title">Haben Sie Ihren Termin gewählt? <em>Buchen Sie online.</em></h2>
        <p>
          Die Verfügbarkeit können Sie direkt online prüfen. Wenn Sie einen Aufenthalt in mehreren Apartments im Haus 116 planen,
          können Sie uns auch anrufen oder schreiben.
        </p>

        <div class="contact-line">
          <div class="contact-item"><span>📞</span><a href="tel:+420728739288">+420 728 739 288</a></div>
          <div class="contact-item"><span>📞</span><a href="tel:+420739753580">+420 739 753 580</a></div>
          <div class="contact-item"><span>✉️</span><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></div>
        </div>
      </div>

      <div>
        <PrevioWidget lang="de" />
      </div>
    </div>
  </section>

  <dialog class="lightbox" id="gallery-lightbox" aria-labelledby="gallery-lightbox-title" aria-modal="true">
    <div class="lightbox__panel" role="document">
      <div class="sr-only" id="gallery-lightbox-title">Galerie des Grünen Apartments</div>

      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Galerie schließen">×</button>
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Vorheriges Foto">‹</button>

      <figure class="lightbox__figure">
        <img id="lightbox-image" src="" alt="" width="1600" height="1100" />
        <figcaption id="lightbox-caption" class="lightbox__caption"></figcaption>
      </figure>

      <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Nächstes Foto">›</button>
    </div>
  </dialog>

  <Footer lang="de" />

  <script>
    (() => {
      const dialog = document.getElementById('gallery-lightbox');
      const image = document.getElementById('lightbox-image');
      const caption = document.getElementById('lightbox-caption');
      const prevButton = dialog?.querySelector('[data-lightbox-prev]');
      const nextButton = dialog?.querySelector('[data-lightbox-next]');
      const closeButtons = dialog?.querySelectorAll('[data-lightbox-close]');

      if (!dialog || !image || !caption) return;

      const galleryGroups = new Map();
      const galleryWrappers = Array.from(document.querySelectorAll('[data-gallery]'));

      if (galleryWrappers.length === 0) return;

      galleryWrappers.forEach((wrapper) => {
        const name = wrapper.getAttribute('data-gallery');
        if (!name) return;

        if (!galleryGroups.has(name)) {
          galleryGroups.set(name, []);
        }

        const buttons = Array.from(wrapper.querySelectorAll('[data-gallery-index]'));
        buttons.forEach((button) => {
          galleryGroups.get(name).push(button);
        });
      });

      let currentGalleryItems = [];
      let currentIndex = 0;
      let lastTrigger = null;

      const buildItems = (galleryName) => {
        const buttons = galleryGroups.get(galleryName) || [];
        return buttons
          .sort((a, b) => Number(a.getAttribute('data-gallery-index')) - Number(b.getAttribute('data-gallery-index')))
          .map((button) => {
            const img = button.querySelector('img');
            return {
              src: img?.getAttribute('src') || '',
              alt: img?.getAttribute('alt') || '',
              trigger: button,
            };
          });
      };

      const renderItem = (index) => {
        const item = currentGalleryItems[index];
        if (!item) return;
        currentIndex = index;
        image.src = item.src;
        image.alt = item.alt;
        caption.textContent = item.alt;
      };

      const openLightbox = (galleryName, index, trigger) => {
        currentGalleryItems = buildItems(galleryName);
        lastTrigger = trigger || null;
        renderItem(index);

        if (typeof dialog.showModal === 'function' && !dialog.open) {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', 'true');
        }

        document.documentElement.classList.add('lightbox-open');
      };

      const closeLightbox = () => {
        if (typeof dialog.close === 'function' && dialog.open) {
          dialog.close();
        } else {
          dialog.removeAttribute('open');
        }

        document.documentElement.classList.remove('lightbox-open');

        if (lastTrigger) {
          lastTrigger.focus();
        }
      };

      const showPrev = () => {
        if (currentGalleryItems.length === 0) return;
        const nextIndex = currentIndex === 0 ? currentGalleryItems.length - 1 : currentIndex - 1;
        renderItem(nextIndex);
      };

      const showNext = () => {
        if (currentGalleryItems.length === 0) return;
        const nextIndex = currentIndex === currentGalleryItems.length - 1 ? 0 : currentIndex + 1;
        renderItem(nextIndex);
      };

      galleryWrappers.forEach((gallery) => {
        gallery.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const trigger = target.closest('[data-gallery-index]');
          if (!trigger) return;

          event.preventDefault();

          const index = Number(trigger.getAttribute('data-gallery-index'));
          if (Number.isNaN(index)) return;

          const galleryName = gallery.getAttribute('data-gallery');
          if (!galleryName) return;

          openLightbox(galleryName, index, trigger);
        });
      });

      prevButton?.addEventListener('click', (event) => {
        event.preventDefault();
        showPrev();
      });

      nextButton?.addEventListener('click', (event) => {
        event.preventDefault();
        showNext();
      });

      closeButtons?.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          closeLightbox();
        });
      });

      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeLightbox();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showPrev();
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showNext();
        }

        if (event.key === 'Escape') {
          event.preventDefault();
          closeLightbox();
        }
      });
    })();
  </script>

  <style>
    .apartment-hero {
      position: relative;
      min-height: 82svh;
      display: grid;
      align-items: end;
      overflow: clip;
      background: var(--color-bg);
    }

    .apartment-hero__media {
      position: absolute;
      inset: 0;
    }

    .apartment-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .apartment-hero__overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(12, 14, 12, 0.7) 0%, rgba(12, 14, 12, 0.28) 42%, rgba(12, 14, 12, 0.12) 100%);
    }

    .apartment-hero__content {
      position: relative;
      z-index: 2;
      width: min(100%, 880px);
      padding: clamp(6rem, 10vw, 9rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
      margin-inline: auto;
      color: #f8f3eb;
    }

    .apartment-hero__eyebrow,
    .section-label {
      margin: 0 0 0.85rem;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(248, 243, 235, 0.78);
    }

    .section-label {
      color: var(--color-muted);
    }

    .apartment-hero h1 {
      margin: 0;
      font-size: clamp(2.8rem, 7vw, 5.8rem);
      line-height: 0.94;
      letter-spacing: -0.03em;
      color: #f8f3eb;
    }

    .apartment-hero__lead {
      max-width: 44rem;
      margin: 1.5rem 0 0;
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.75;
      color: rgba(248, 243, 235, 0.88);
    }

    .apartment-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .apartment-hero-btn,
    .apartment-hero-btn:link,
    .apartment-hero-btn:visited,
    .btn-primary,
    .btn-ghost,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      padding: 0.85rem 1.2rem;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .apartment-hero-btn--primary,
    .apartment-hero-btn--primary:link,
    .apartment-hero-btn--primary:visited {
      background-color: #6f8f6b;
      border: 1px solid #6f8f6b;
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(30, 40, 30, 0.18);
    }

    .apartment-hero-btn--primary:hover,
    .apartment-hero-btn--primary:focus-visible {
      background-color: #5f7d5b;
      border-color: #5f7d5b;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(30, 40, 30, 0.22);
    }

    .apartment-hero-btn--primary:active {
      transform: translateY(0);
      background-color: #557051;
      border-color: #557051;
      color: #ffffff;
    }

    .apartment-hero-btn--ghost,
    .apartment-hero-btn--ghost:link,
    .apartment-hero-btn--ghost:visited {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #fff;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: none;
    }

    .apartment-hero-btn--ghost:hover,
    .apartment-hero-btn--ghost:focus-visible {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.42);
      color: #fff;
      transform: translateY(-1px);
    }

    .apartment-hero-btn--ghost:active {
      transform: translateY(0);
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.5);
      color: #fff;
    }

    .section-inner {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .apartment-facts,
    .apartment-intro,
    .apartment-layout,
    .apartment-highlights,
    .apartment-gallery,
    .apartment-equipment-link,
    .apartment-booking {
      padding: clamp(4.5rem, 7vw, 7rem) 0;
    }

    .apartment-facts {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .facts-grid {
      display: grid;
      gap: 1rem;
    }

    .facts-grid--simple {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 780px;
      margin-inline: auto;
    }

    .fact-card {
      padding: 1.25rem 1rem;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: 1.2rem;
      text-align: center;
    }

    .fact-label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
