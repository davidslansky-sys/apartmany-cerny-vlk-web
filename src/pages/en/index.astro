---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PrevioWidget from '../../components/PrevioWidget.astro';
---

<BaseLayout
  lang="en"
  title="Apartments Černý vlk – Borová Lada, Šumava"
  description="5 apartments in the quiet centre of Šumava. Borová Lada – nature, comfort, trips and local amenities all within walking distance."
  image="/images/hero/hero-borova-lada.jpg"
>
  <Header />

  <section class="hero" id="uvod">
    <div
      class="hero-bg"
      style="background-image:url('/images/hero/hero-borova-lada.jpg');"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Borová Lada · Šumava</p>
      <h1>
        In the quiet centre of Šumava.
        <em>Yet with everything important close by.</em>
      </h1>
      <p class="hero-perex">
        Borová Lada lies in the heart of Šumava National Park, with forests, cycling routes and cross-country ski trails starting almost right behind the village.
        At the same time, restaurants, a pastry shop, a store, sports facilities and a playground are all within easy walking distance.
      </p>
      <div class="hero-actions">
        <a href="#rezervace" class="btn-primary">Check availability</a>
        <a href="#apartmany" class="btn-ghost">View apartments</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">Scroll</div>
  </section>

  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat"><span><strong>5 apartments</strong> · 2 houses</span></div>
      <div class="stat"><span><strong>4–8 guests</strong> / apartment</span></div>
      <div class="stat"><span>Total capacity <strong>28 guests</strong></span></div>
      <div class="stat"><span>Rating <strong>9.4 / 10</strong></span></div>
    </div>
  </div>

  <section id="apartmany">
    <div class="section-inner">
      <p class="section-label reveal">Accommodation</p>
      <h2 class="section-title reveal reveal-delay-1">Five apartments. <em>One shared character.</em></h2>
      <p class="section-lead reveal reveal-delay-2">
        Each apartment has its own name, colour and orientation. What connects them is the same focus on comfort,
        quality facilities and a setting that works equally well for a weekend stay or a longer holiday.
      </p>

      <div class="apt-grid">
        <div class="apt-row-label">House No. 116</div>

        <div class="apt-card-big reveal">
          <div class="apt-photo">
            <img
              src="/images/apartmany/cerveny/cerveny-01.jpg"
              alt="Red apartment – main living area"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="apt-info">
            <div class="apt-name-row">
              <span class="apt-color-dot" style="background:#c0392b"></span>
              <h3 class="apt-name">Red</h3>
            </div>
            <div class="apt-meta">
              <span class="apt-meta-item">8 guests</span>
              <span class="apt-meta-item">3 bedrooms</span>
              <span class="apt-meta-item">116 m²</span>
              <span class="apt-meta-item">No. 116</span>
            </div>
            <p class="apt-desc">
              The largest apartment, with a spacious social area across the entire ground floor. Three bedrooms, two bathrooms,
              a separate toilet and plenty of room for larger families or groups of friends.
            </p>
            <a href="/en/apartmany/cerveny" class="apt-link">Apartment detail</a>
          </div>
        </div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zluty/zluty-01.jpg"
                alt="Yellow apartment – main living area"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#d4a017"></span>
                <h3 class="apt-name">Yellow</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 guests</span>
                <span class="apt-meta-item">2 bedrooms</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                A bright apartment with afternoon and evening sun. A practical layout for families and a comfortable option for longer stays.
              </p>
              <a href="/en/apartmany/zluty" class="apt-link">Apartment detail</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zeleny/zeleny-01.jpg"
                alt="Green apartment – main living area"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#2e7d32"></span>
                <h3 class="apt-name">Green</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 guests</span>
                <span class="apt-meta-item">2 bedrooms</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                An apartment with morning sun and a calm atmosphere. Ideal for guests who like to head out into nature early in the day.
              </p>
              <a href="/en/apartmany/zeleny" class="apt-link">Apartment detail</a>
            </div>
          </div>
        </div>

        <div class="apt-row-label">House No. 117</div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/modry/modry-01.jpg"
                alt="Blue apartment – main living area"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#1565c0"></span>
                <h3 class="apt-name">Blue</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 guests</span>
                <span class="apt-meta-item">2 bedrooms</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                A comfortable apartment with morning sun and a pleasant layout for relaxed stays in every season.
              </p>
              <a href="/en/apartmany/modry" class="apt-link">Apartment detail</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/sedy/sedy-01.jpg"
                alt="Grey apartment – main living area"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#607d8b"></span>
                <h3 class="apt-name">Grey</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 guests</span>
                <span class="apt-meta-item">2 bedrooms</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                A quiet apartment with afternoon sun. The same practical layout and comfort as the Blue apartment, ideal for couples and families.
              </p>
              <a href="/en/apartmany/sedy" class="apt-link">Apartment detail</a>
            </div>
          </div>
        </div>
      </div>

      <div class="home-secondary-actions reveal">
        <a href="/en/apartmany" class="btn-primary">All apartments</a>
        <a href="/en/vybaveni" class="btn-ghost">Shared amenities and services</a>
      </div>
    </div>
  </section>

  <section id="okoli">
    <div class="section-inner">
      <div class="okoli-layout">
        <div class="okoli-text">
          <p class="section-label reveal">Location</p>
          <h2 class="section-title reveal reveal-delay-1">Šumava on your doorstep. <em>In every season.</em></h2>
          <p class="reveal reveal-delay-2">
            Cycling routes and cross-country ski trails start almost right outside the village. Borová Lada is an excellent base for trips across the Czech and Bavarian sides of Šumava.
          </p>
          <p class="reveal">
            In summer, you can enjoy forest paths, peat bogs, viewpoints and natural swimming spots in the surrounding area. In winter, cross-country trails and ski resorts are within easy reach on both the Czech and German sides.
          </p>
          <p class="reveal">
            At the same time, you stay in a peaceful place with clean air and all the essentials pleasantly close at hand.
          </p>

          <div class="okoli-actions reveal">
            <a href="/en/okoli" class="btn-primary">Explore the area</a>
          </div>
        </div>

        <div class="okoli-photos reveal">
          <img
            src="/images/okoli/okoli-01.jpg"
            alt="Šumava landscape near Borová Lada"
            width="800"
            height="280"
            loading="lazy"
          />
          <img
            src="/images/okoli/hriste-bl.jpg"
            alt="Playground in Borová Lada near the apartments"
            width="400"
            height="200"
            loading="lazy"
          />
          <img
            src="/images/okoli/okoli-05.jpg"
            alt="Nature and trips around Borová Lada"
            width="400"
            height="200"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="recenze">
    <div class="section-inner">
      <div class="recenze-header">
        <div>
          <p class="section-label reveal">Guest feedback</p>
          <h2 class="section-title reveal reveal-delay-1">What our <em>guests say</em></h2>
        </div>
        <div class="recenze-score reveal">
          <div class="score-big">9.4</div>
          <div class="score-sub">Overall rating across the main platforms and publicly available guest reviews.</div>
          <div class="score-sources">
            <span class="score-src">Booking.com 9.4 / 10 · 98 reviews</span>
            <span class="score-src">Google 4.9 / 5 · 93 reviews</span>
            <span class="score-src">Mapy.com 5.0 / 5 · 24 reviews</span>
            <span class="score-src">Previo.cz 9.7 / 10 · 84 reviews</span>
          </div>
        </div>
      </div>

      <div class="reviews-grid">
        <div class="review-card reveal">
          <p class="review-quote">
            Very thoughtfully designed and excellently equipped — we really did not miss anything, from the kitchen equipment to the boot dryer.
          </p>
          <div class="review-author"><strong>Jindřiška</strong> · April 2025</div>
        </div>
        <div class="review-card reveal reveal-delay-1">
          <p class="review-quote">
            Beautiful location, stylish apartments and immediate access to the surrounding nature. We especially appreciated the well-equipped kitchen and the practical storage space.
          </p>
          <div class="review-author"><strong>Hunor</strong> · Booking.com</div>
        </div>
        <div class="review-card reveal reveal-delay-2">
          <p class="review-quote">
            The apartments are new and cosy. We really enjoyed our holiday and would gladly come back again.
          </p>
          <div class="review-author"><strong>Tomáš</strong> · Google</div>
        </div>
      </div>

      <div class="recenze-cta reveal">
        <a href="/en/recenze">→ Read all reviews</a>
      </div>
    </div>
  </section>

  <section id="rezervace">
    <div class="section-inner">
      <div class="rezervace-layout">
        <div class="rezervace-info">
          <p class="section-label reveal">Booking</p>
          <h2 class="section-title reveal reveal-delay-1">Availability <em>and online booking</em></h2>
          <p class="reveal reveal-delay-2">
            Check available dates online. Bookings are confirmed immediately, with no waiting and no phone calls needed.
          </p>

          <div class="contact-line reveal">
            <div class="contact-item"><span>📞</span><a href="tel:+420728739288">+420 728 739 288</a></div>
            <div class="contact-item"><span>📞</span><a href="tel:+420739753580">+420 739 753 580</a></div>
            <div class="contact-item"><span>✉️</span><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></div>
          </div>
        </div>

        <div class="reveal">
          <PrevioWidget lang="en" />
        </div>
      </div>
    </div>
  </section>

  <Footer lang="en" />

  <script>
    {`
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.14 });

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    `}
  </script>

  <style>
    .okoli-actions,
    .home-secondary-actions {
      margin-top: 1.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }
  </style>
</BaseLayout>
