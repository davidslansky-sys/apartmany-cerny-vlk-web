---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PrevioWidget from '../../components/PrevioWidget.astro';
---

<BaseLayout
  lang="de"
  title="Apartmány Černý vlk – Borová Lada, Böhmerwald"
  description="5 Apartments im ruhigen Zentrum des Böhmerwalds. Borová Lada – Natur, Infrastruktur, Ausflüge und Sportanlagen bequem zu Fuß erreichbar."
  image="/images/hero/hero-borova-lada.jpg"
>
  <Header />

  <section class="hero" id="uvod">
    <div
      class="hero-bg"
      style="background-image:url('/images/hero/hero-borova-lada.jpg');"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Borová Lada · Böhmerwald</p>
      <h1>
        Im ruhigen Zentrum des Böhmerwalds.
        <em>Und doch mit allem Wichtigen in Reichweite.</em>
      </h1>
      <p class="hero-perex">
        Borová Lada liegt im Herzen des Nationalparks Šumava – Wälder, Radwege und Langlaufloipen beginnen praktisch direkt hinter dem Ort.
        Gleichzeitig erreichen Sie Restaurants, Konditorei, Geschäft, Sportanlagen und einen Kinderspielplatz bequem zu Fuß.
      </p>
      <div class="hero-actions">
        <a href="#rezervace" class="btn-primary">Verfügbarkeit prüfen</a>
        <a href="#apartmany" class="btn-ghost">Apartments ansehen</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">Scroll</div>
  </section>

  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat"><span><strong>5 Apartments</strong> · 2 Häuser</span></div>
      <div class="stat"><span><strong>4–8 Personen</strong> / Apartment</span></div>
      <div class="stat"><span>Gesamtkapazität <strong>28 Personen</strong></span></div>
      <div class="stat"><span>Bewertung <strong>9,4 / 10</strong></span></div>
    </div>
  </div>

  <section id="apartmany">
    <div class="section-inner">
      <p class="section-label reveal">Unterkunft</p>
      <h2 class="section-title reveal reveal-delay-1">Fünf Apartments. <em>Ein gemeinsamer Charakter.</em></h2>
      <p class="section-lead reveal reveal-delay-2">
        Jedes Apartment hat seinen eigenen Namen, seine eigene Farbe und Ausrichtung. Alle verbindet jedoch derselbe Fokus auf Komfort,
        hochwertige Ausstattung und ein Umfeld, das sowohl für ein Wochenende als auch für längere Aufenthalte bestens funktioniert.
      </p>

      <div class="apt-grid">
        <div class="apt-row-label">Haus Nr. 116</div>

        <div class="apt-card-big reveal">
          <div class="apt-photo">
            <img
              src="/images/apartmany/cerveny/cerveny-01.jpg"
              alt="Rotes Apartment – Hauptraum"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="apt-info">
            <div class="apt-name-row">
              <span class="apt-color-dot" style="background:#c0392b"></span>
              <h3 class="apt-name">Rotes</h3>
            </div>
            <div class="apt-meta">
              <span class="apt-meta-item">8 Personen</span>
              <span class="apt-meta-item">3 Schlafzimmer</span>
              <span class="apt-meta-item">116 m²</span>
              <span class="apt-meta-item">Nr. 116</span>
            </div>
            <p class="apt-desc">
              Das größte Apartment mit großzügigem Wohnbereich über das gesamte Erdgeschoss. Drei Schlafzimmer, zwei Badezimmer,
              ein separates WC und viel Platz für größere Familien oder Freundesgruppen.
            </p>
            <a href="/de/cerveny" class="apt-link">Apartment-Detail</a>
          </div>
        </div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zluty/zluty-01.jpg"
                alt="Gelbes Apartment – Hauptraum"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#d4a017"></span>
                <h3 class="apt-name">Gelbes</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 Personen</span>
                <span class="apt-meta-item">2 Schlafzimmer</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Helles Apartment mit Nachmittags- und Abendsonne. Praktischer Grundriss für Familien und komfortabel auch für längere Aufenthalte.
              </p>
              <a href="/de/zluty" class="apt-link">Apartment-Detail</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zeleny/zeleny-01.jpg"
                alt="Grünes Apartment – Hauptraum"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#2e7d32"></span>
                <h3 class="apt-name">Grünes</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 Personen</span>
                <span class="apt-meta-item">2 Schlafzimmer</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Apartment mit Morgensonne und ruhiger Atmosphäre. Ideal für Gäste, die gleich nach dem Frühstück in die Natur aufbrechen möchten.
              </p>
              <a href="/de/zeleny" class="apt-link">Apartment-Detail</a>
            </div>
          </div>
        </div>

        <div class="apt-row-label">Haus Nr. 117</div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/modry/modry-01.jpg"
                alt="Blaues Apartment – Hauptraum"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#1565c0"></span>
                <h3 class="apt-name">Blaues</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 Personen</span>
                <span class="apt-meta-item">2 Schlafzimmer</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Komfortables Apartment mit Morgensonne und angenehmem Wohnkomfort für entspannte längere Aufenthalte zu jeder Jahreszeit.
              </p>
              <a href="/de/modry" class="apt-link">Apartment-Detail</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/sedy/sedy-01.jpg"
                alt="Graues Apartment – Hauptraum"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#607d8b"></span>
                <h3 class="apt-name">Graues</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 Personen</span>
                <span class="apt-meta-item">2 Schlafzimmer</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Ruhiges Apartment mit Nachmittagssonne. Gleicher Grundriss und Komfort wie das Blaue Apartment, ideal für Paare und Familien.
              </p>
              <a href="/de/sedy" class="apt-link">Apartment-Detail</a>
            </div>
          </div>
        </div>
      </div>

      <div class="home-secondary-actions reveal">
        <a href="/de/#rezervace" class="btn-primary">Verfügbarkeit prüfen</a>
        <a href="/de/vybaveni/" class="btn-secondary">Ausstattung und Service</a>
      </div>
    </div>
  </section>

  <section id="okoli">
    <div class="section-inner">
      <div class="okoli-layout">
        <div class="okoli-text">
          <p class="section-label reveal">Lage</p>
          <h2 class="section-title reveal reveal-delay-1">Der Böhmerwald vor der Tür. <em>Zu jeder Jahreszeit.</em></h2>
          <p class="reveal reveal-delay-2">
            Radwege und Langlaufloipen beginnen praktisch direkt hinter dem Ort. Borová Lada ist ein idealer Ausgangspunkt für Ausflüge im tschechischen und bayerischen Böhmerwald.
          </p>
          <p class="reveal">
            Im Sommer erwarten Sie Waldwege, Hochmoore, Ausblicke und Naturbademöglichkeiten in der Umgebung. Im Winter erreichen Sie Langlaufstrecken und Skigebiete auf tschechischer wie auch deutscher Seite.
          </p>
          <p class="reveal">
            Gleichzeitig wohnen Sie an einem ruhigen Ort mit sauberer Luft und allem Wichtigen in angenehmer Reichweite.
          </p>

          <div class="okoli-actions reveal">
            <a href="/de/okoli" class="btn-primary">Umgebung entdecken</a>
          </div>
        </div>

        <div class="okoli-photos reveal">
          <img
            src="/images/okoli/okoli-01.jpg"
            alt="Böhmerwald-Landschaft in der Umgebung von Borová Lada"
            width="800"
            height="280"
            loading="lazy"
          />
          <img
            src="/images/okoli/hriste-bl.jpg"
            alt="Spielplatz in Borová Lada nahe den Apartments"
            width="400"
            height="200"
            loading="lazy"
          />
          <img
            src="/images/okoli/okoli-05.jpg"
            alt="Natur und Ausflüge in der Umgebung von Borová Lada"
            width="400"
            height="200"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="recenze">
    <div class="section-inner">
      <div class="recenze-header">
        <div>
          <p class="section-label reveal">Gäste über uns</p>
          <h2 class="section-title reveal reveal-delay-1">Was unsere <em>Gäste schreiben</em></h2>
        </div>
        <div class="recenze-score reveal">
          <div class="score-big">9,4</div>
          <div class="score-sub">Gesamtbewertung über die wichtigsten Plattformen und öffentlich verfügbaren Gästebewertungen hinweg.</div>
          <div class="score-sources">
            <span class="score-src">Booking.com 9,4 / 10 · 98 Bewertungen</span>
            <span class="score-src">Google 4,9 / 5 · 93 Bewertungen</span>
            <span class="score-src">Mapy.com 5,0 / 5 · 24 Bewertungen</span>
            <span class="score-src">Previo.cz 9,7 / 10 · 84 Bewertungen</span>
          </div>
        </div>
      </div>

      <div class="reviews-grid">
        <div class="review-card reveal">
          <p class="review-quote">
            Sehr gut durchdacht, hervorragend ausgestattet – uns fehlte wirklich an nichts, von der Küchenausstattung bis zum Schuhtrockner.
          </p>
          <div class="review-author"><strong>Jindřiška</strong> · April 2025</div>
        </div>
        <div class="review-card reveal reveal-delay-1">
          <p class="review-quote">
            Wunderschöne Lage, stilvolle Apartments und unmittelbarer Kontakt zur umliegenden Natur. Besonders geschätzt haben wir die gut ausgestattete Küche und den praktischen Abstellraum.
          </p>
          <div class="review-author"><strong>Hunor</strong> · Booking.com</div>
        </div>
        <div class="review-card reveal reveal-delay-2">
          <p class="review-quote">
            Die Apartments sind neu und gemütlich eingerichtet. Wir haben unseren Urlaub sehr genossen und kommen gerne wieder.
          </p>
          <div class="review-author"><strong>Tomáš</strong> · Google</div>
        </div>
      </div>

      <div class="recenze-cta reveal">
        <a href="/de/recenze" class="btn-primary">Alle Bewertungen lesen</a>
      </div>
    </div>
  </section>

  <section id="rezervace">
    <div class="section-inner">
      <div class="rezervace-layout">
        <div class="rezervace-info">
          <p class="section-label reveal">Reservierung</p>
          <h2 class="section-title reveal reveal-delay-1">Freie Termine <em>und Buchung</em></h2>
          <p class="reveal reveal-delay-2">
            Prüfen Sie die Verfügbarkeit direkt online. Reservierungen werden sofort bestätigt – ohne Warten und ohne Telefonate.
          </p>

          <div class="contact-line reveal">
            <div class="contact-item"><span>📞</span><a href="tel:+420728739288">+420 728 739 288</a></div>
            <div class="contact-item"><span>📞</span><a href="tel:+420739753580">+420 739 753 580</a></div>
            <div class="contact-item"><span>✉️</span><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></div>
          </div>
        </div>

        <div class="reveal">
          <PrevioWidget lang="de" />
        </div>
      </div>
    </div>
  </section>

  <Footer lang="de" />

  <script>
    {`
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.14 });

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    `}
  </script>

  <style>
    .okoli-actions,
    .home-secondary-actions,
    .recenze-cta {
      margin-top: 1.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .home-secondary-actions .btn-primary,
    .home-secondary-actions .btn-secondary,
    .okoli-actions .btn-primary,
    .recenze-cta .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.25rem;
      padding: 0.9rem 1.2rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      line-height: 1;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .home-secondary-actions .btn-primary,
    .home-secondary-actions .btn-primary:link,
    .home-secondary-actions .btn-primary:visited,
    .okoli-actions .btn-primary,
    .okoli-actions .btn-primary:link,
    .okoli-actions .btn-primary:visited,
    .recenze-cta .btn-primary,
    .recenze-cta .btn-primary:link,
    .recenze-cta .btn-primary:visited {
      color: #ffffff;
    }

    .home-secondary-actions .btn-primary:hover,
    .home-secondary-actions .btn-primary:focus-visible,
    .okoli-actions .btn-primary:hover,
    .okoli-actions .btn-primary:focus-visible,
    .recenze-cta .btn-primary:hover,
    .recenze-cta .btn-primary:focus-visible {
      color: #ffffff;
      text-decoration: none;
    }

    .home-secondary-actions .btn-secondary,
    .home-secondary-actions .btn-secondary:link,
    .home-secondary-actions .btn-secondary:visited {
      background: transparent;
      border: 1px solid rgba(28, 34, 38, 0.18);
      color: var(--color-text, #1f2933);
      box-shadow: none;
    }

    .home-secondary-actions .btn-secondary:hover,
    .home-secondary-actions .btn-secondary:focus-visible {
      background: rgba(255, 255, 255, 0.72);
      border-color: rgba(28, 34, 38, 0.28);
      color: var(--color-heading, #111827);
      transform: translateY(-1px);
      text-decoration: none;
    }

    .home-secondary-actions .btn-secondary:active {
      transform: translateY(0);
    }

    @media (max-width: 720px) {
      .home-secondary-actions,
      .recenze-cta {
        flex-direction: column;
        align-items: stretch;
      }

      .home-secondary-actions .btn-primary,
      .home-secondary-actions .btn-secondary,
      .recenze-cta .btn-primary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
