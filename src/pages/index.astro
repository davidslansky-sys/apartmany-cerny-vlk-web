---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrevioWidget from '../components/PrevioWidget.astro';
---

<BaseLayout
  lang="cs"
  title="Apartmány Černý vlk – Borová Lada, Šumava"
  description="5 apartmánů v klidném centru Šumavy. Borová Lada – příroda, vybavenost, výlety i sportoviště v pohodlné docházkové vzdálenosti."
  image="/images/hero/hero-borova-lada.jpg"
>
  <Header />

  <section class="hero" id="uvod">
    <div
      class="hero-bg"
      style="background-image:url('/images/hero/hero-borova-lada.jpg');"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Borová Lada · Šumava</p>
      <h1>
        V klidném centru Šumavy.
        <em>A přesto s veškerým zázemím.</em>
      </h1>
      <p class="hero-perex">
        Borová Lada leží v srdci Národního parku Šumava – lesy, cyklostezky i běžkařské stopy začínají prakticky za obcí.
        Přitom tu máte v pohodlné docházkové vzdálenosti restaurace, cukrárnu, obchod, sportoviště i dětské hřiště.
      </p>
      <div class="hero-actions">
        <a href="#rezervace" class="btn-primary">Zkontrolovat dostupnost</a>
        <a href="#apartmany" class="btn-ghost">Prohlédnout apartmány</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">Scroll</div>
  </section>

  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat"><span><strong>5 apartmánů</strong> · 2 objekty</span></div>
      <div class="stat"><span><strong>4–8 osob</strong> / apartmán</span></div>
      <div class="stat"><span>Celková kapacita <strong>28 osob</strong></span></div>
      <div class="stat"><span>Hodnocení <strong>9,4 / 10</strong></span></div>
    </div>
  </div>

  <section id="apartmany">
    <div class="section-inner">
      <p class="section-label reveal">Ubytování</p>
      <h2 class="section-title reveal reveal-delay-1">Pět apartmánů. <em>Jeden charakter.</em></h2>
      <p class="section-lead reveal reveal-delay-2">
        Každý apartmán má vlastní jméno, barvu i světovou stranu. Všechny ale spojuje stejný důraz na pohodlí,
        kvalitní vybavení a zázemí, které funguje pro víkend i delší pobyt.
      </p>

      <div class="apt-grid">
        <div class="apt-row-label">Objekt č.p. 116</div>

        <div class="apt-card-big reveal">
          <div class="apt-photo">
            <img
              src="/images/apartmany/cerveny/cerveny-16.jpg"
              alt="Červený apartmán – hlavní interiér"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="apt-info">
            <div class="apt-name-row">
              <span class="apt-color-dot" style="background:#c0392b"></span>
              <h3 class="apt-name">Červený</h3>
            </div>
            <div class="apt-meta">
              <span class="apt-meta-item">8 osob</span>
              <span class="apt-meta-item">3 ložnice</span>
              <span class="apt-meta-item">116 m²</span>
            </div>
            <p class="apt-desc">
              Největší apartmán s prostornou společenskou místností přes celé přízemí. Tři ložnice, dvě koupelny,
              samostatné WC a velkorysé zázemí pro vícečlennou rodinu nebo skupinu přátel.
            </p>
            <a href="/apartmany/cerveny" class="apt-link">Detail apartmánu</a>
          </div>
        </div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zluty/zluty-01.jpg"
                alt="Žlutý apartmán – hlavní interiér"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#d4a017"></span>
                <h3 class="apt-name">Žlutý</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 osob</span>
                <span class="apt-meta-item">2 ložnice</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Světlý apartmán s odpoledním a večerním sluncem. Praktické rozvržení pro rodinu a pohodlné zázemí i pro delší pobyty.
              </p>
              <a href="/apartmany/zluty" class="apt-link">Detail apartmánu</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/zeleny/zeleny-01.jpg"
                alt="Zelený apartmán – hlavní interiér"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#2e7d32"></span>
                <h3 class="apt-name">Zelený</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 osob</span>
                <span class="apt-meta-item">2 ložnice</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Apartmán s ranním sluncem a klidnou atmosférou. Ideální pro hosty, kteří chtějí vyrážet do přírody hned po snídani.
              </p>
              <a href="/apartmany/zeleny" class="apt-link">Detail apartmánu</a>
            </div>
          </div>
        </div>

        <div class="apt-row-label">Objekt č.p. 117</div>

        <div class="apt-row">
          <div class="apt-card-sm reveal">
            <div class="apt-photo">
              <img
                src="/images/apartmany/modry/modry-01.jpg"
                alt="Modrý apartmán – hlavní interiér"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#1565c0"></span>
                <h3 class="apt-name">Modrý</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 osob</span>
                <span class="apt-meta-item">2 ložnice</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Nadstandardní apartmán s ranním sluncem a komfortem pro pohodové delší pobyty v každém ročním období.
              </p>
              <a href="/apartmany/modry" class="apt-link">Detail apartmánu</a>
            </div>
          </div>

          <div class="apt-card-sm reveal reveal-delay-1">
            <div class="apt-photo">
              <img
                src="/images/apartmany/sedy/sedy-01.jpg"
                alt="Šedý apartmán – hlavní interiér"
                width="600"
                height="300"
                loading="lazy"
              />
            </div>
            <div class="apt-info">
              <div class="apt-name-row">
                <span class="apt-color-dot" style="background:#607d8b"></span>
                <h3 class="apt-name">Šedý</h3>
              </div>
              <div class="apt-meta">
                <span class="apt-meta-item">4+1 osob</span>
                <span class="apt-meta-item">2 ložnice</span>
                <span class="apt-meta-item">56 m²</span>
              </div>
              <p class="apt-desc">
                Klidný apartmán s odpoledním sluncem. Stejné rozložení a komfort jako Modrý apartmán, ideální pro páry i rodiny.
              </p>
              <a href="/apartmany/sedy" class="apt-link">Detail apartmánu</a>
            </div>
          </div>
        </div>
      </div>

      <div class="home-secondary-actions reveal">
        <a href="/#rezervace" class="btn-primary">Zobrazit dostupnost</a>
        <a href="/vybaveni" class="btn-secondary">Společné vybavení a služby</a>
      </div>
    </div>
  </section>

  <section id="okoli">
    <div class="section-inner">
      <div class="okoli-layout">
        <div class="okoli-text">
          <p class="section-label reveal">Lokalita</p>
          <h2 class="section-title reveal reveal-delay-1">Šumava za dveřmi. <em>V každém ročním období.</em></h2>
          <p class="reveal reveal-delay-2">
            Cyklostezky a běžkařské stopy začínají prakticky za obcí. Borová Lada je ideální výchozí bod pro výlety po české i bavorské Šumavě.
          </p>
          <p class="reveal">
            V létě vás čekají lesní cesty, rašeliniště, výhledy i koupání v okolní přírodě. V zimě máte v dosahu běžkařské trasy i sjezdovky na české i německé straně.
          </p>
          <p class="reveal">
            Přitom zůstáváte v místě, kde je klid, čistý vzduch a vše důležité v rozumné dostupnosti.
          </p>

          <div class="okoli-actions reveal">
            <a href="/okoli" class="btn-primary">Prozkoumat okolí</a>
          </div>
        </div>

        <div class="okoli-photos reveal">
          <img
            src="/images/okoli/okoli-01.jpg"
            alt="Šumavská krajina v okolí Borových Lad"
            width="800"
            height="280"
            loading="lazy"
          />
          <img
            src="/images/okoli/hriste-bl.jpg"
            alt="Hřiště v Borových Ladech poblíž apartmánů"
            width="400"
            height="200"
            loading="lazy"
          />
          <img
            src="/images/okoli/okoli-05.jpg"
            alt="Příroda a výlety v okolí Borových Lad"
            width="400"
            height="200"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="recenze">
    <div class="section-inner">
      <div class="recenze-header">
        <div>
          <p class="section-label reveal">Hosté o nás</p>
          <h2 class="section-title reveal reveal-delay-1">Co o nás <em>píšou hosté</em></h2>
        </div>
        <div class="recenze-score reveal">
          <div class="score-big">9,4</div>
          <div class="score-sub">Souhrnné hodnocení napříč hlavními platformami a veřejně dostupnými recenzemi hostů.</div>
          <div class="score-sources">
            <span class="score-src">Booking.com 9,4 / 10 · 98 hodnocení</span>
            <span class="score-src">Google 4,9 / 5 · 93 hodnocení</span>
            <span class="score-src">Mapy.com 5,0 / 5 · 24 hodnocení</span>
            <span class="score-src">Previo.cz 9,7 / 10 · 84 hodnocení</span>
          </div>
        </div>
      </div>

      <div class="reviews-grid">
        <div class="review-card reveal">
          <p class="review-quote">
            Dispozičně skvěle řešeno, vybavenost na výborné úrovni – de facto nám tu nechybělo nic, od vybavení kuchyně po vysoušeč bot.
          </p>
          <div class="review-author"><strong>Jindřiška</strong> · duben 2025</div>
        </div>
        <div class="review-card reveal reveal-delay-1">
          <p class="review-quote">
            Krásná lokalita, stylové apartmány a bezprostřední kontakt s okolní přírodou. Oceňovali jsme dobře vybavenou kuchyň i praktickou komoru.
          </p>
          <div class="review-author"><strong>Hunor</strong> · Booking.com</div>
        </div>
        <div class="review-card reveal reveal-delay-2">
          <p class="review-quote">
            Apartmány jsou nové, hezky útulně zařízené. Dovolenou jsme si užili a rádi se vrátíme znovu.
          </p>
          <div class="review-author"><strong>Tomáš</strong> · Google</div>
        </div>
      </div>

      <div class="recenze-cta reveal">
        <a href="/recenze" class="btn-primary">Přečíst všechny recenze</a>
      </div>
    </div>
  </section>

  <section id="rezervace">
    <div class="section-inner">
      <div class="rezervace-layout">
        <div class="rezervace-info">
          <p class="section-label reveal">Rezervace</p>
          <h2 class="section-title reveal reveal-delay-1">Volné termíny <em>a rezervace</em></h2>
          <p class="reveal reveal-delay-2">
            Zkontrolujte dostupnost přímo online. Rezervace jsou potvrzené okamžitě – bez čekání a telefonátů.
          </p>

          <div class="contact-line reveal">
            <div class="contact-item"><span>📞</span><a href="tel:+420728739288">+420 728 739 288</a></div>
            <div class="contact-item"><span>📞</span><a href="tel:+420739753580">+420 739 753 580</a></div>
            <div class="contact-item"><span>✉️</span><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></div>
          </div>
        </div>

        <div class="reveal">
          <PrevioWidget lang="cs" />
        </div>
      </div>
    </div>
  </section>

  <Footer lang="cs" />

  <script>
    {`
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.14 });

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    `}
  </script>

  <style>
    .okoli-actions,
    .home-secondary-actions,
    .recenze-cta {
      margin-top: 1.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .home-secondary-actions .btn-primary,
    .home-secondary-actions .btn-secondary,
    .okoli-actions .btn-primary,
    .recenze-cta .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.25rem;
      padding: 0.9rem 1.2rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      line-height: 1;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .home-secondary-actions .btn-primary,
    .home-secondary-actions .btn-primary:link,
    .home-secondary-actions .btn-primary:visited,
    .okoli-actions .btn-primary,
    .okoli-actions .btn-primary:link,
    .okoli-actions .btn-primary:visited,
    .recenze-cta .btn-primary,
    .recenze-cta .btn-primary:link,
    .recenze-cta .btn-primary:visited {
      color: #ffffff;
    }

    .home-secondary-actions .btn-primary:hover,
    .home-secondary-actions .btn-primary:focus-visible,
    .okoli-actions .btn-primary:hover,
    .okoli-actions .btn-primary:focus-visible,
    .recenze-cta .btn-primary:hover,
    .recenze-cta .btn-primary:focus-visible {
      color: #ffffff;
      text-decoration: none;
    }

    .home-secondary-actions .btn-secondary,
    .home-secondary-actions .btn-secondary:link,
    .home-secondary-actions .btn-secondary:visited {
      background: transparent;
      border: 1px solid rgba(28, 34, 38, 0.18);
      color: var(--color-text, #1f2933);
      box-shadow: none;
    }

    .home-secondary-actions .btn-secondary:hover,
    .home-secondary-actions .btn-secondary:focus-visible {
      background: rgba(255, 255, 255, 0.72);
      border-color: rgba(28, 34, 38, 0.28);
      color: var(--color-heading, #111827);
      transform: translateY(-1px);
      text-decoration: none;
    }

    .home-secondary-actions .btn-secondary:active {
      transform: translateY(0);
    }

    @media (max-width: 720px) {
      .home-secondary-actions,
      .recenze-cta {
        flex-direction: column;
        align-items: stretch;
      }

      .home-secondary-actions .btn-primary,
      .home-secondary-actions .btn-secondary,
      .recenze-cta .btn-primary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
