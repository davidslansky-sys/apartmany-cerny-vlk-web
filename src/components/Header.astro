---
import type { Locale } from '../data/apartments';
import { getRoute } from '../i18n/routes';
import { t, languages } from '../i18n/ui';
import { stripLocaleFromPathname, localizePath } from '../lib/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'cs' } = Astro.props;

const pathname = Astro.url.pathname;
const currentPath = stripLocaleFromPathname(pathname);

const navItems = [
  { key: 'navApartments', href: '#apartmany' },
  { key: 'navAmenities', href: getRoute('vybaveni', lang) },
  { key: 'navSurroundings', href: getRoute('okoli', lang) },
  { key: 'navReviews', href: getRoute('recenze', lang) },
  { key: 'navBooking', href: '#rezervace' }
] as const;

const languageLinks = [
  {
    code: 'cs' as const,
    label: languages.cs,
    href: localizePath(currentPath, 'cs')
  },
  {
    code: 'de' as const,
    label: languages.de,
    href: localizePath(currentPath, 'de')
  },
  {
    code: 'en' as const,
    label: languages.en,
    href: localizePath(currentPath, 'en')
  }
];

function isActiveLink(href: string) {
  if (href.startsWith('#')) return false;
  return pathname === href;
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={getRoute('home', lang)} aria-label="Apartmány Černý vlk">
      <span class="brand-mark" aria-hidden="true">ČV</span>
      <span class="brand-text">
        <strong>Apartmány Černý vlk</strong>
        <small>Borová Lada · Šumava</small>
      </span>
    </a>

    <nav class="main-nav" aria-label="Hlavní navigace">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link',
              { 'is-active': isActiveLink(item.href) }
            ]}
            aria-current={isActiveLink(item.href) ? 'page' : undefined}
          >
            {t(lang, item.key)}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <div class="lang-switcher" aria-label="Přepínač jazyků">
        {
          languageLinks.map((item) => (
            <a
              href={item.href}
              class:list={['lang-link', { 'is-current': item.code === lang }]}
              lang={item.code}
              hreflang={item.code}
              aria-current={item.code === lang ? 'true' : undefined}
            >
              {item.code.toUpperCase()}
            </a>
          ))
        }
      </div>

      <a class="header-cta btn-primary" href="#rezervace">
        {t(lang, 'ctaAvailability')}
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="mobile-nav" aria-label="Mobilní navigace">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'mobile-nav-link',
              { 'is-active': isActiveLink(item.href) }
            ]}
            aria-current={isActiveLink(item.href) ? 'page' : undefined}
          >
            {t(lang, item.key)}
          </a>
        ))
      }

      <div class="mobile-lang-switcher">
        {
          languageLinks.map((item) => (
            <a
              href={item.href}
              class:list={['lang-link', { 'is-current': item.code === lang }]}
              lang={item.code}
              hreflang={item.code}
              aria-current={item.code === lang ? 'true' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <a class="btn-primary mobile-cta" href="#rezervace">
        {t(lang, 'ctaAvailability')}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      mobileMenu.hidden = expanded;
      document.documentElement.classList.toggle('menu-open', !expanded);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        mobileMenu.hidden = true;
        document.documentElement.classList.remove('menu-open');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    backdrop-filter: blur(18px);
    background: rgba(14, 18, 20, 0.58);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    width: min(1200px, calc(100% - 2rem));
    min-height: 5rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: #fff;
    min-width: 0;
  }

  .brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-text strong {
    font-size: 0.98rem;
    color: #fff;
  }

  .brand-text small {
    margin-top: 0.18rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.15rem;
    min-width: 0;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.84);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .lang-switcher,
  .mobile-lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.3rem;
    min-height: 2.3rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lang-link:hover,
  .lang-link:focus-visible,
  .lang-link.is-current {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .header-cta,
  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    line-height: 1;
    color: #ffffff;
  }

  .header-cta:link,
  .header-cta:visited,
  .header-cta:hover,
  .header-cta:focus-visible,
  .mobile-cta:link,
  .mobile-cta:visited,
  .mobile-cta:hover,
  .mobile-cta:focus-visible {
    color: #ffffff;
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.22rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .menu-toggle span:not(.sr-only) {
    width: 1rem;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    display: block;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 980px) {
    .main-nav,
    .header-actions .lang-switcher,
    .header-actions .header-cta {
      display: none;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu {
      display: block;
      width: min(1200px, calc(100% - 2rem));
      margin: 0 auto 1rem;
      padding-bottom: 0.5rem;
    }

    .mobile-nav {
      display: grid;
      gap: 0.65rem;
      padding: 1rem;
      border-radius: 1.25rem;
      background: rgba(12, 16, 18, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mobile-nav-link {
      padding: 0.85rem 0;
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mobile-nav-link.is-active {
      color: #ffffff;
    }

    .mobile-lang-switcher {
      padding-top: 0.35rem;
      flex-wrap: wrap;
    }

    .mobile-cta {
      margin-top: 0.35rem;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      width: min(100% - 1rem, 1200px);
      min-height: 4.4rem;
    }

    .brand-text small {
      display: none;
    }

    .brand-mark {
      width: 2.2rem;
      height: 2.2rem;
    }

    .brand-text strong {
      font-size: 0.92rem;
    }
  }
</style>
