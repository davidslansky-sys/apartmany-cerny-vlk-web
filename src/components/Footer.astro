---
import type { Locale } from '../data/apartments';
import { apartments } from '../data/apartments';
import { getRoute } from '../i18n/routes';
import { getApartmentUrl } from '../lib/apartmentUrls';

interface Props {
  lang?: Locale;
}

const { lang = 'cs' } = Astro.props;

const labels = {
  cs: {
    brandText: 'Stylové horské apartmány v Borové Ladě, v srdci Národního parku Šumava.',
    apartments: 'Apartmány',
    site: 'Web',
    contact: 'Kontakt',
    amenities: 'Vybavení',
    surroundings: 'Okolí',
    reviews: 'Recenze',
    booking: 'Rezervace',
    addressLabel: 'Adresa',
    social: 'Sociální sítě',
    rights: 'Všechna práva vyhrazena.'
  },
  de: {
    brandText: 'Stilvolle Bergapartments in Borová Lada, im Herzen des Nationalparks Šumava.',
    apartments: 'Apartments',
    site: 'Web',
    contact: 'Kontakt',
    amenities: 'Ausstattung',
    surroundings: 'Umgebung',
    reviews: 'Bewertungen',
    booking: 'Reservierung',
    addressLabel: 'Adresse',
    social: 'Soziale Netzwerke',
    rights: 'Alle Rechte vorbehalten.'
  },
  en: {
    brandText: 'Stylish mountain apartments in Borová Lada, in the heart of Šumava National Park.',
    apartments: 'Apartments',
    site: 'Website',
    contact: 'Contact',
    amenities: 'Amenities',
    surroundings: 'Surroundings',
    reviews: 'Reviews',
    booking: 'Booking',
    addressLabel: 'Address',
    social: 'Social media',
    rights: 'All rights reserved.'
  }
}[lang];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href={getRoute('home', lang)} aria-label="Apartmány Černý vlk">
        <span class="footer-logo-mark" aria-hidden="true">ČV</span>
        <span class="footer-logo-text">Apartmány Černý vlk</span>
      </a>
      <p>{labels.brandText}</p>
    </div>

    <div class="footer-col">
      <h3>{labels.apartments}</h3>
      <ul>
        {
          apartments.map((apartment) => (
            <li>
              <a href={getApartmentUrl(apartment.key, lang)}>
                {apartment.names[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-col">
      <h3>{labels.site}</h3>
      <ul>
        <li><a href={getRoute('vybaveni', lang)}>{labels.amenities}</a></li>
        <li><a href={getRoute('okoli', lang)}>{labels.surroundings}</a></li>
        <li><a href={getRoute('recenze', lang)}>{labels.reviews}</a></li>
        <li><a href={getRoute('kontakt', lang)}>{labels.booking}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{labels.contact}</h3>
      <ul class="footer-contact">
        <li>
          <strong>{labels.addressLabel}</strong><br />
          Borová Lada 116 a 117<br />
          384 92 Borová Lada
        </li>
        <li><a href="tel:+420728739288">+420 728 739 288</a></li>
        <li><a href="tel:+420739753580">+420 739 753 580</a></li>
        <li><a href="mailto:recepce@apartmanycernyvlk.cz">recepce@apartmanycernyvlk.cz</a></li>
        <li>
          <strong>{labels.social}</strong><br />
          <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>,
          <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>,
          <a href="https://www.tripadvisor.com/" target="_blank" rel="noopener noreferrer">TripAdvisor</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Apartmány Černý vlk. {labels.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    color: rgba(255, 255, 255, 0.84);
    background:
      linear-gradient(180deg, rgba(17, 23, 25, 0.96), rgba(10, 14, 16, 1));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-inner {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 2.25rem;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.15fr;
    gap: 2rem;
  }

  .footer-brand p {
    margin-top: 1rem;
    max-width: 34ch;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: #ffffff;
  }

  .footer-logo-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .footer-logo-text {
    font-weight: 700;
    font-size: 1rem;
  }

  .footer-col h3 {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: 0.95rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: #ffffff;
    text-decoration: none;
  }

  .footer-contact li {
    line-height: 1.55;
  }

  .footer-contact strong {
    color: #ffffff;
    font-weight: 600;
  }

  .footer-bottom {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.1rem 0 1.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.9rem;
  }

  @media (max-width: 1100px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .footer-inner {
      width: min(100% - 1rem, 1200px);
      padding: 3rem 0 1.75rem;
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-bottom {
      width: min(100% - 1rem, 1200px);
      padding-bottom: 1.4rem;
    }
  }
</style>
